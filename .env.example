# ──────────────────────────────────────────────────────────────────────────
# Smart Loan — environment defaults
#
# Copy to .env and tweak. Every var the API actually reads is documented
# here; missing-but-needed vars surface as warnings at boot
# (see apps/api/src/config.ts).
# ──────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# Local Postgres install. Default port 5432 — change if you have another
# instance bound there. Create the database once with:
#   createdb smart_loan
# (or the equivalent in your client).
DATABASE_URL=postgres://loan:loan@localhost:5432/smart_loan

# ── API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
HOST=0.0.0.0

# 32+ chars — used to sign JWTs. **MUST** be changed before deploying.
# A weak secret is the single biggest security risk in this app.
JWT_SECRET=change-me-in-prod-please-32-chars-minimum

# CORS origin the api will allow.
WEB_ORIGIN=http://localhost:5173

# Optional. If set, payment webhook callbacks + PDF document URLs use this
# as their public base. In dev, leave unset to fall back to localhost:PORT.
# Production: set to your real public API URL (https://api.yourcompany.tld).
# PUBLIC_API_URL=

# Customizes the COMPANY_NAME placeholder in generated PDF documents
# (promissory notes, demand letters, etc.).
COMPANY_NAME=SmartLoan

# Issuer label shown in TOTP apps (e.g. Google Authenticator) when staff
# enrol 2FA. Defaults to "SmartLoan".
TOTP_ISSUER=SmartLoan

# Sentry DSN — leave empty in development to disable error reporting.
# Production: paste your project DSN.
SENTRY_DSN=

# Where uploaded documents land. Defaults to ./uploads relative to cwd.
# UPLOADS_DIR=./uploads

# UUID of the placeholder "system" user that owns scheduled-job-posted
# entries (interest accrual, late fees). Defaults to the zero-UUID; seed
# a real user and set this in production for clearer audit trails.
# SYSTEM_USER_ID=

# ── Providers (FRD §3.2 et al.) ─────────────────────────────────────────
# All three default to MOCK so dev / CI works out of the box. Switch to
# real implementations when you have provider credentials.

# Notification provider. MOCK = stub that records the dispatch but doesn't
# actually send. (Future real options: SENDGRID, TWILIO, SES.)
NOTIFICATION_PROVIDER=MOCK
# Required if you switch to SENDGRID / SES / TWILIO. Wire as needed.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=

# Payment provider. MOCK = synchronous fake that auto-marks intents PAID.
# (Future real options: GCASH, MAYA, DRAGONPAY.)
PAYMENT_PROVIDER=MOCK
# GCASH_MERCHANT_ID=
# GCASH_API_KEY=
# MAYA_PUBLIC_KEY=
# MAYA_SECRET_KEY=
# DRAGONPAY_MERCHANT_ID=
# DRAGONPAY_PASSWORD=

# AML / sanctions screening provider. MOCK = matches against the local
# AmlWatchlistEntry table only. (Future real options: COMPLY_ADVANTAGE,
# REFINITIV, WORLD_CHECK.)
AML_PROVIDER=MOCK
# COMPLY_ADVANTAGE_API_KEY=
# REFINITIV_API_KEY=

# ── Local LLM assistant (optional, FRD differentiation) ─────────────────
# Empty (default) = mock provider; the AI side-panel still renders but
# returns "configure Ollama" canned responses. The whole app works
# without these set — turning the assistant on is opt-in.
#
# Install Ollama on the host (https://ollama.com), pull a model, then:
#   OLLAMA_URL=http://localhost:11434
# OLLAMA_URL=

# Model to pull. phi3:mini is 2.3GB, runs OK on CPU. llama3.1:8b is
# 4.7GB, smarter, needs a GPU or patience. Pull once with:
#   ollama pull phi3:mini
OLLAMA_MODEL=phi3:mini

# Soft ceiling on response length. Most prompts complete well under
# this; we just don't want runaway generations.
OLLAMA_MAX_TOKENS=512

# ── Face-match (web app, build-time) ────────────────────────────────────
# Where the face-api.js model weights are served from. Defaults to
# /models (you must copy weights into apps/web/public/models). For
# CDN-based dev:
#   VITE_FACE_API_MODELS=https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model/
# VITE_FACE_API_MODELS=

# ── Web ──────────────────────────────────────────────────────────────────
WEB_PORT=5173
