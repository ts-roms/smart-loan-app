# ──────────────────────────────────────────────────────────────────────────
# Smart Loan — environment defaults
# Copy to .env and tweak. Docker compose reads this file automatically.
# ──────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# Host-side port. 5433 by default so it doesn't collide with the sibling
# Click-POS postgres (which already binds 5432). Inside the docker network
# services still reach postgres on its container port 5432 — only the host
# mapping changes.
POSTGRES_USER=loan
POSTGRES_PASSWORD=loan
POSTGRES_DB=smart_loan
POSTGRES_PORT=5433

# Used by host-side dev (`pnpm dev`). The container exposes 5432 internally
# on the bridge network and maps to POSTGRES_PORT on localhost.
DATABASE_URL=postgres://loan:loan@localhost:5433/smart_loan

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=3001
# 32+ chars — used to sign JWTs. Change before deploying.
JWT_SECRET=change-me-in-prod-please-32-chars-minimum
# CORS origin the api will allow. In full-stack docker mode the web app
# is served via nginx on the same host, so this matches the web port.
WEB_ORIGIN=http://localhost:5173

# ── Web ──────────────────────────────────────────────────────────────────
WEB_PORT=5173

# ── pgAdmin (optional, only loaded with --profile full) ──────────────────
PGADMIN_EMAIL=admin@loan.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
