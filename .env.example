# ──────────────────────────────────────────────────────────────────────────
# Smart Loan — environment defaults
#
# Copy to .env and tweak. Every var the API actually reads is documented
# here; missing-but-needed vars surface as warnings at boot
# (see apps/api/src/config.ts).
# ──────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# Port 5433 matches the dev Postgres container in docker-compose.dev.yml,
# which `pnpm dev:up` starts for you. 5433 rather than the default 5432
# so it never collides with a Postgres you already have installed.
#
# Using your own Postgres instead? Point this at it (usually :5432) and
# create the database once with `createdb smart_loan`.
DATABASE_URL=postgres://loan:loan@localhost:5433/smart_loan

# ── API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# The API reads PORT, not API_PORT — config.ts:75. Setting API_PORT
# does nothing and the server silently takes the 3001 default, which
# is how two processes end up fighting over the same port.
PORT=3001
# Dual-stack: Node binds `::` with ipv6Only off, so this accepts IPv4
# too. Needed on hosts whose private network is IPv6-only (Railway), and
# harmless everywhere else. Use 0.0.0.0 only if IPv6 is disabled.
HOST=::

# 32+ chars — used to sign JWTs. **MUST** be changed before deploying.
# A weak secret is the single biggest security risk in this app.
JWT_SECRET=change-me-in-prod-please-32-chars-minimum

# CORS origin the api will allow.
WEB_ORIGIN=http://localhost:5173

# Where the marketing site is served. Separate deployment from the app
# above. Used to build the self-serve signup confirmation link, which
# has to land on the marketing site's /signup/confirm page — the person
# clicking it has no account anywhere yet. Only matters when
# MULTI_TENANT=true, since hosted signup is refused otherwise.
MARKETING_ORIGIN=http://localhost:5175

# Optional. If set, payment webhook callbacks + PDF document URLs use this
# as their public base. In dev, leave unset to fall back to localhost:PORT.
# Production: set to your real public API URL (https://api.yourcompany.tld).
# PUBLIC_API_URL=

# Customizes the COMPANY_NAME placeholder in generated PDF documents
# (promissory notes, demand letters, etc.).
COMPANY_NAME=SmartLoan

# Issuer label shown in TOTP apps (e.g. Google Authenticator) when staff
# enrol 2FA. Defaults to "SmartLoan".
TOTP_ISSUER=SmartLoan

# Sentry DSN — leave empty in development to disable error reporting.
# Production: paste your project DSN.
SENTRY_DSN=

# Where uploaded documents land. Defaults to ./uploads relative to cwd.
# Used by the local-disk backend, which is the default.
# UPLOADS_DIR=./uploads

# ── Object storage (roadmap 3.1) ────────────────────────────────────────
#
# Which backend holds uploaded files: KYC documents, selfies, collateral
# photographs, signatures, the company logo.
#
#   unset / blank / LOCAL   local disk under UPLOADS_DIR (the default,
#                           and what every deployment runs today)
#   S3                      any S3-compatible bucket: AWS S3, MinIO,
#                           Cloudflare R2, DigitalOcean Spaces
#
# Leaving this unset changes nothing. An unrecognised value also falls
# back to local disk rather than failing to boot.
#
# Setting S3 WITHOUT the three required settings below is a hard failure
# in production and a warning in development, because the fallback would
# otherwise put regulated KYC records on a container filesystem while the
# config claims they are in a bucket.
#
# Note that files are still SERVED through the API rather than by
# redirecting the browser to a bucket URL. That is deliberate: the
# /uploads/ responses carry a sandbox CSP and X-Content-Type-Options,
# and neither survives a redirect to another origin.
#
# STORAGE_DRIVER=S3
# S3_BUCKET=smartloan-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-southeast-1
# S3_SESSION_TOKEN=
#
# Custom endpoint for MinIO / R2 / Spaces. Leave blank for real AWS S3.
# Setting it turns on path-style addressing automatically; override with
# S3_FORCE_PATH_STYLE if your provider needs virtual-host style.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
#
# IMPORTANT — backups. deploy/backup/backup.sh archives UPLOADS_DIR when
# it is set. Moving to S3 does NOT automatically cover those files: see
# the "Uploaded files" section of that script before switching over.

# UUID of the placeholder "system" user that owns scheduled-job-posted
# entries (interest accrual, late fees). Defaults to the zero-UUID; seed
# a real user and set this in production for clearer audit trails.
# SYSTEM_USER_ID=

# ── Providers ───────────────────────────────────────────────────────────
# All three default to MOCK so dev / CI works out of the box. Switch to
# real implementations when you have provider credentials.

# Notification provider. MOCK = stub that records the dispatch but doesn't
# actually send. SENDGRID (email) and TWILIO (SMS) are implemented; SES is
# not yet.
#
# MOCK IS REFUSED UNDER NODE_ENV=production. It records every send as SENT
# while delivering nothing, so a production deployment on the default looks
# healthy while no borrower ever receives a reminder. Set a real provider
# and its credentials, or set MOCK explicitly having decided this
# deployment sends nothing — either way the choice is deliberate.
NOTIFICATION_PROVIDER=MOCK

# SENDGRID needs the first two; FROM_NAME is the optional display name.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=

# TWILIO needs all three. FROM_PHONE is E.164, e.g. +15551234567.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=

# Per-request ceiling on a provider call, in ms. Exists because several
# call sites await a dispatch in the HTTP request path after the financial
# write has committed — a hung provider socket must not hang that response.
# NOTIFICATION_TIMEOUT_MS=10000

# Tenants may override the above per channel with their own credentials on
# SystemConfig (Admin → Settings). These are the platform-shared fallback,
# and the only credentials the scheduled reminder jobs use.

# Payment provider. MOCK = synchronous fake that auto-marks intents PAID.
# (Future real options: GCASH, MAYA, DRAGONPAY.)
PAYMENT_PROVIDER=MOCK
# GCASH_MERCHANT_ID=
# GCASH_API_KEY=
# MAYA_PUBLIC_KEY=
# MAYA_SECRET_KEY=
# DRAGONPAY_MERCHANT_ID=
# DRAGONPAY_PASSWORD=

# AML / sanctions screening provider. MOCK = matches against the local
# AmlWatchlistEntry table only. (Future real options: COMPLY_ADVANTAGE,
# REFINITIV, WORLD_CHECK.)
AML_PROVIDER=MOCK
# COMPLY_ADVANTAGE_API_KEY=
# REFINITIV_API_KEY=

# ── Local LLM assistant (optional) ──────────────────────────────────────
# Empty (default) = mock provider; the AI side-panel still renders but
# returns "configure Ollama" canned responses. The whole app works
# without these set — turning the assistant on is opt-in.
#
# Install Ollama on the host (https://ollama.com), pull a model, then:
#   OLLAMA_URL=http://localhost:11434
# OLLAMA_URL=

# Model to pull. phi3:mini is 2.3GB, runs OK on CPU. llama3.1:8b is
# 4.7GB, smarter, needs a GPU or patience. Pull once with:
#   ollama pull phi3:mini
OLLAMA_MODEL=phi3:mini

# Soft ceiling on response length. Most prompts complete well under
# this; we just don't want runaway generations.
OLLAMA_MAX_TOKENS=512

# ── Face-match (web app, build-time) ────────────────────────────────────
# Where the face-api.js model weights are served from. Defaults to
# /models (you must copy weights into apps/web/public/models). For
# CDN-based dev:
#   VITE_FACE_API_MODELS=https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model/
# VITE_FACE_API_MODELS=

# ── Licensing ────────────────────────────────────────────────────────────
# Public key (Ed25519) used to verify license tokens at boot + on
# /license/activate. ONE of LICENSE_PUBLIC_KEY_PEM or
# LICENSE_PUBLIC_KEY_PATH must be set in production; leaving both empty
# runs the API in "grace mode" where every license check returns NO_KEY
# (Phase 1a returns the status; Phase 1b blocks premium routes).
#
# For dev: run `pnpm --filter @loan/licensing keygen` once to mint a
# keypair into libs/licensing/keys/, then point this at the public half.
# LICENSE_PUBLIC_KEY_PATH=libs/licensing/keys/public.pem
# LICENSE_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n

# Platform-side only — keep private.pem on the machine that issues
# licenses (typically your laptop or the platform console deploy).
# NEVER ship to a tenant. Default resolution is libs/licensing/keys/private.pem.
# LICENSE_PRIVATE_KEY_PATH=libs/licensing/keys/private.pem

# ── Web ──────────────────────────────────────────────────────────────────
WEB_PORT=5173
