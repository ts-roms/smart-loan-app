# SmartLoan production environment — Docker compose stack.
#
# Copy this to `.env` in the same directory as docker-compose.yml,
# fill in the marked values, then `docker compose up -d`. Anything
# left blank gets the default.

# ─── REQUIRED ──────────────────────────────────────────────────────────

# Postgres password. Make this random and long. The stack creates the
# DB on first boot with this password; changing it later requires also
# changing it inside the running Postgres.
POSTGRES_PASSWORD=

# 32+ random characters. Used to sign JWTs (staff sessions, customer
# portal sessions, password reset tokens). Rotating this invalidates
# every existing session, so plan rotation around a maintenance window.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Public origin the tenant web app is served from. Used for CORS and
# for emailed links. NO trailing slash. Example:
#   WEB_ORIGIN=https://lending.your-coop.example
WEB_ORIGIN=

# Your vendor-issued public key. Either inline (escape newlines with
# \n inside the env value) or as a path inside the api container.
# Without this set, license activation will fail.
#
# Easiest: paste the multi-line PEM here, ringed by quotes:
#   LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n....\n-----END PUBLIC KEY-----\n"
LICENSE_PUBLIC_KEY_PEM=

# ─── OPTIONAL ──────────────────────────────────────────────────────────

# Database name + user. Defaults are fine for most installs.
POSTGRES_DB=smart_loan
POSTGRES_USER=loan

# Host-port that nginx (the web container) listens on. 8080 keeps it
# clear of common ports; if you have a host-level TLS proxy in front,
# point that proxy at this.
WEB_PORT=8080

# Public-facing URL the API advertises in webhooks / emails. Defaults
# to the WEB_ORIGIN above; override if the API is reachable at a
# different hostname (e.g. api.coop.example vs lending.coop.example).
PUBLIC_API_URL=

# Branding shown across the UI + on PDFs. Override the SmartLoan
# defaults if you're white-labeling.
COMPANY_NAME=SmartLoan
TOTP_ISSUER=SmartLoan

# Provider plugins. Defaults to MOCK so nothing is sent externally
# until you've set up real credentials. Each non-MOCK choice requires
# its own env variables — see libs/<provider>/README in the source.
NOTIFICATION_PROVIDER=MOCK
PAYMENT_PROVIDER=MOCK
AML_PROVIDER=MOCK

# Sentry (error tracking). Empty = errors only appear in container logs.
SENTRY_DSN=

# Ollama local-LLM assistant. Point at a host running Ollama
# (https://ollama.com); leave blank to disable the assistant feature.
OLLAMA_URL=
OLLAMA_MODEL=phi3:mini
