# SmartLoan tenant web app — production image
#
# Two-stage build:
#   1. `builder`  — full pnpm install + `vite build` to produce static dist/
#   2. `runtime`  — nginx:alpine serving the dist/. Reverse-proxies /api/v1
#                   to the api service (named in docker-compose).
#
# We don't ship the platform console or marketing site here — those are
# vendor-side apps, not part of the cooperative's install. Each
# cooperative deploys this image + the api image + Postgres, that's it.

ARG NODE_VERSION=20.18.0
FROM node:${NODE_VERSION}-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc* package.json tsconfig.base.json ./
COPY apps ./apps
COPY libs ./libs

# Install + Prisma generate (the web app's TS imports types from
# @loan/db, which requires the generated client to exist).
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @loan/db prisma:generate

# Build the tenant web app. Outputs to apps/web/dist.
RUN pnpm --filter @loan/web build

# ─── runtime ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Strip the stock nginx config — we provide our own that handles SPA
# routing (fallback all paths to index.html) and proxies /api/v1 to
# the api service.
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*.conf
COPY deploy/docker/nginx.web.conf /etc/nginx/conf.d/default.conf

# Copy the built SPA. nginx serves these as static files.
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

# Use 127.0.0.1, not "localhost": the alpine image's /etc/hosts resolves
# localhost to ::1 (IPv6) first, but nginx's `listen 80;` binds IPv4
# only, so a localhost probe is refused and the container is wrongly
# marked unhealthy. 127.0.0.1 forces the IPv4 loopback nginx listens on.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/health.txt || exit 1

# nginx-alpine's default ENTRYPOINT + CMD start nginx in the foreground;
# we don't override.
