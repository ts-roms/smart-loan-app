# SmartLoan platform console — Railway image
#
# Same two stages as deploy/docker/Dockerfile.web. It exists separately
# rather than as a flag on that one because the runtime differs in three
# ways that all trace back to Railway deciding things at deploy time:
#
#   1. nginx binds $PORT, assigned per deploy, so the config has to be a
#      template rather than a file.
#   2. The API upstream is private DNS (<service>.railway.internal), not
#      a compose service name.
#   3. No EXPOSE and no HEALTHCHECK — Railway reads the port from the
#      service config and runs its own probe from outside the container.
#
# Build context is the REPO ROOT, not this directory. Set that in the
# service's build settings; see README.md.

ARG NODE_VERSION=20.18.0
FROM node:${NODE_VERSION}-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc* package.json tsconfig.base.json ./
COPY apps ./apps
COPY libs ./libs

RUN pnpm install --frozen-lockfile

# The console imports types from @loan/db, so the generated Prisma
# client has to exist before tsc runs — same reason as the tenant web
# image. Without it every prisma.* type resolves to `any` and the build
# fails on noImplicitAny.
RUN pnpm --filter @loan/db prisma:generate

RUN pnpm --filter @loan/platform build

# ─── runtime ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*.conf

# Templates in this directory are envsubst'd into /etc/nginx/conf.d at
# container start by the base image's entrypoint.
COPY deploy/railway/nginx.spa.conf.template \
     /etc/nginx/templates/default.conf.template
# Proxy prefixes for THIS app. `.inc`, not `.conf`, so nginx.conf's
# http-level `include conf.d/*.conf` doesn't also pull it in outside
# the server block, where a bare `location` would be a syntax error.
COPY deploy/railway/proxy-platform.inc /etc/nginx/conf.d/proxy-platform.inc

# Substitute ONLY these two. Left unset, envsubst replaces every $name
# it finds — including nginx's own $uri, $host and
# $proxy_add_x_forwarded_for — with empty strings, which produces a
# config that starts cleanly and then misroutes.
# Default port, so the image is self-sufficient.
#
# The template does `listen ${PORT}`, and envsubst turns an unset PORT
# into an empty string — nginx then dies at startup with
#   [emerg] host not found in "${PORT}" of the "listen" directive
# and the container exits 1 before writing anything useful. On Railway
# that surfaces as a FAILED deploy with no deploy logs at all, which
# then silently falls back to the previous builder. Reproduced locally
# by running this image with no PORT.
#
# A platform that injects PORT still wins — runtime env overrides ENV.
ENV PORT=8080

ENV NGINX_ENVSUBST_FILTER='^(PORT|API_UPSTREAM|NGINX_LOCAL_RESOLVERS)$'

# Opt in to the base image populating NGINX_LOCAL_RESOLVERS from
# /etc/resolv.conf. 15-local-resolvers.envsh returns early unless this is
# set, so without it the template's `resolver ${NGINX_LOCAL_RESOLVERS}`
# survives substitution as a literal and nginx dies at startup with
#   [emerg] host not found in resolver "${NGINX_LOCAL_RESOLVERS}"
# — the very crash-loop the resolver was added to prevent.
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# Sensible default for the common single-environment setup. Override in
# the service variables when the API service is named something else.
ENV API_UPSTREAM=http://api.railway.internal:3001

COPY --from=builder /app/apps/platform/dist /usr/share/nginx/html
