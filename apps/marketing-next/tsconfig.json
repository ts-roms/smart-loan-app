{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /*
     * `jsx: preserve` and `moduleResolution: bundler` are Next's
     * requirements, not ours — the base config's `react-jsx` would make
     * `next build` rewrite this file on every run.
     */
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    /*
     * `baseUrl` MUST be restated. tsconfig.base.json sets it to "."
     * relative to ITSELF (the repo root), and `paths` is replaced
     * wholesale rather than merged — so without this line `@/*` would
     * resolve to <repo-root>/src/*. The @loan/* entries the base config
     * drops here are not missed: pnpm links every workspace package
     * into node_modules, and `moduleResolution: bundler` reads their
     * package.json `main`/`exports` directly.
     */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "dist/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
