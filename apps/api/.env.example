# API-only env (used when running `pnpm dev:api` on the host).
# Copy to apps/api/.env. Docker compose injects its own values, so this
# file is for host-side development only.

DATABASE_URL=postgres://loan:loan@localhost:5433/smart_loan
JWT_SECRET=dev-only-secret-change-me
WEB_ORIGIN=http://localhost:5173
PORT=3001
HOST=0.0.0.0
