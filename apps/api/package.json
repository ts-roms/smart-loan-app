{
  "name": "@loan/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "serve": "tsx watch src/main.ts",
    "build": "node ../../scripts/ensure-prisma-client.mjs && tsc -p tsconfig.app.json --noEmit",
    "start": "pnpm --filter @loan/db exec prisma migrate deploy && tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@loan/accounting": "workspace:*",
    "@loan/auth": "workspace:*",
    "@loan/credit-scoring": "workspace:*",
    "@loan/db": "workspace:*",
    "@loan/decisioning": "workspace:*",
    "@loan/features": "workspace:*",
    "@loan/jobs": "workspace:*",
    "@loan/kyc": "workspace:*",
    "@loan/licensing": "workspace:*",
    "@loan/loans": "workspace:*",
    "@loan/notifications": "workspace:*",
    "@loan/payments": "workspace:*",
    "@loan/pdf": "workspace:*",
    "@loan/screening": "workspace:*",
    "@loan/shared-types": "workspace:*",
    "@loan/shared-utils": "workspace:*",
    "@sentry/node": "^10.69.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.11.0",
    "otplib": "^12.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "~5.7.3",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:server"
    ]
  }
}
