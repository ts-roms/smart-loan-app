.DS_Store

# Runtime file storage (UPLOADS_DIR — KYC scans, signatures, logos).
# Anchored to the two places the API actually resolves it from: the repo
# root and apps/api, depending on the cwd it was started with.
#
# These MUST stay anchored. A bare `uploads/` matches any directory of
# that name at any depth, which silently swallowed
# apps/api/src/features/uploads/ — the route module was written, never
# tracked, and the API stopped booting on a missing import.
/uploads/
/apps/api/uploads/

# Raw PSA PSGC publication CSV — downloaded by an operator and fed to
# scripts/ingest-psgc.mjs to regenerate the bundled city/barangay
# datasets. Not tracked because the file is freely re-downloadable and
# we don't want a 3 MB raw CSV in git history.
data/

.claude/worktrees
.claude/settings.local.json
# TypeScript incremental build artifacts
*.tsbuildinfo

# Written by `pnpm --filter @loan/db bootstrap-admin`. Contains a
# plaintext bootstrap password; delete it after first sign-in.
admin-credentials.txt
