# Env for @loan/db. Copy to libs/db/.env.
#
# Why this file exists at all: Prisma resolves .env relative to the
# schema, not the repo root. So `npx prisma <anything>` run from this
# directory reads libs/db/.env and ignores the root one — without it,
# DATABASE_URL is unset and prisma fails with "Environment variable not
# found: DATABASE_URL".
#
# The package scripts sidestep this by forcing the root env
# (`dotenv -e ../../.env -- prisma ...`), so the gap only shows up on a
# direct `npx prisma` — which is also what the tenant migration runner
# spawns during provisioning.
#
# Only DATABASE_URL belongs here. Copying the whole root .env across
# works too, but then there are two copies of every setting and nothing
# keeping them in step: this file sat on :5432 while the container had
# always been on :5433, and every direct prisma call failed with P1001
# until someone noticed.

# Must match DATABASE_URL in the root .env. Port 5433 is the dev
# container from docker-compose.dev.yml (mapped 127.0.0.1:5433->5432),
# chosen so it never collides with a Postgres you already have on 5432.
DATABASE_URL=postgres://loan:loan@localhost:5433/smart_loan
