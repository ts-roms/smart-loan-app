// Prisma schema — smart-loan-app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users (internal staff + customer accounts) ──────────────────────────────

enum UserRole {
  ADMIN // full access
  LOAN_OFFICER // approves/rejects loans, runs KYC
  ACCOUNTANT // records payments, reconciles
  COLLECTOR // works assigned delinquent accounts
  CUSTOMER // self-serve borrower
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Save-once personnel signature. When personnel ask to download a
  /// generated document "with my signature", we embed the image stored at
  /// this URL. Null = no signature saved; the signature block on PDFs is
  /// just omitted in that case. Captured/managed via /auth/me/signature.
  defaultSignatureUrl String?
  signatureSavedAt    DateTime?

  /// "Mark as read" cursor for the notification bell. Notifications
  /// created after this timestamp count as unseen; opening the bell or
  /// hitting the dedicated endpoint advances it to now().
  lastSeenNotificationAt DateTime?

  /// TOTP shared secret (base32). Null = 2FA not set up. Even when set,
  /// `totpEnabled` must be true for the login flow to require a code —
  /// gives the user a "configure but don't enable yet" mode.
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  /// Single-use recovery codes (sha256 hashes). On a successful use the
  /// code is removed from this list; running out → user must reset 2FA.
  totpRecoveryCodes String[] @default([])

  /// Cutoff for "force logout". Every access token issued at or before
  /// this instant is rejected by `app.authenticate`.
  ///
  /// A timestamp rather than a denylist of token ids because access
  /// tokens are stateless and we never see them again after signing:
  /// there is nothing to add to a list. Comparing the JWT's own `iat`
  /// against one column revokes every outstanding token for the user at
  /// once, which is exactly what "log them out everywhere" means, and
  /// costs one nullable column instead of a table.
  ///
  /// Null = never force-logged-out, the case for almost every row.
  ///
  /// Second-resolution, because `iat` is. See the comparison in
  /// libs/auth/src/plugin.ts, which floors the cutoff to the second so a
  /// token minted in the same second as the revocation is treated as
  /// revoked rather than surviving it.
  sessionsRevokedAt DateTime?

  /// Last authenticated request from this user. Powers the online
  /// indicator; null means they have never signed in.
  ///
  /// Written by `app.authenticate`, throttled — see HEARTBEAT_MS in
  /// @loan/shared-utils. Presence is DERIVED from this at read time
  /// rather than stored as a boolean, because a stored flag has no way
  /// to become false: a crashed process, a closed laptop or dead wifi
  /// all leave it stuck on "online" forever. A timestamp decays on its
  /// own.
  ///
  /// Deliberately NOT indexed. It is read as part of a row already
  /// fetched by primary key, and it is the single hottest-written
  /// column on User — an index would be paid on every heartbeat to
  /// serve a filtered query that does not exist yet. Add one with the
  /// query that needs it.
  lastSeenAt        DateTime?

  // What this user did across the system (auditable trail)
  kycSubmissions            KycSubmission[]        @relation("KycSubmittedBy")
  kycDecisions              KycSubmission[]        @relation("KycDecidedBy")
  loanApplications          LoanApplication[]      @relation("LoanSubmittedBy")
  loanDecisions             LoanApplication[]      @relation("LoanDecidedBy")
  loanDisbursals            LoanApplication[]      @relation("LoanDisbursedBy")
  loanPayments              LoanPayment[]          @relation("PaymentRecordedBy")
  surveyResponses           SurveyResponse[]       @relation("SurveyComputedBy")
  journalEntries            JournalEntry[]         @relation("JournalPostedBy")
  collectionNotes           CollectionNote[]       @relation("CollectionNoteBy")
  promisesToPay             PromiseToPay[]         @relation("PtpCreatedBy")
  collectionAccounts        CollectionAssignment[] @relation("CollectionAssignedTo")
  collectionAssignmentsMade CollectionAssignment[] @relation("CollectionAssignedBy")
  paymentIntents            PaymentIntent[]        @relation("PaymentIntentBy")
  auditEvents               AuditEvent[]           @relation("AuditActor")
  roleAssignments           UserRoleAssignment[]   @relation("UserRoleAssignedTo")
  delegationsGranted        Delegation[]           @relation("Delegator")
  delegationsHeld           Delegation[]           @relation("Delegate")
  loanApprovals             LoanApproval[]         @relation("LoanApprover")
  refreshTokens             RefreshToken[]         @relation("UserRefreshTokens")
  passwordResets            PasswordResetToken[]   @relation("UserPasswordResets")
  penaltyWaivers            PenaltyWaiver[]        @relation("PenaltyWaivedBy")
  annualDocuments           AnnualDocument[]       @relation("AnnualDocSubmittedBy")
  demandLettersDrafted      DemandLetter[]         @relation("DemandLetterDrafted")
  demandLettersApproved     DemandLetter[]         @relation("DemandLetterApproved")
  demandLettersDispatched   DemandLetter[]         @relation("DemandLetterDispatched")
  demandLettersWaived       DemandLetter[]         @relation("DemandLetterWaived")
  reposIdentified           RepossessionCase[]     @relation("RepoIdentified")
  reposBmApproved           RepossessionCase[]     @relation("RepoBmApproved")
  reposCreditApproved       RepossessionCase[]     @relation("RepoCreditApproved")
  reposLegalApproved        RepossessionCase[]     @relation("RepoLegalApproved")
  reposAgentAssigned        RepossessionCase[]     @relation("RepoAgentAssigned")
  reposRecovered            RepossessionCase[]     @relation("RepoRecovered")
  reposAuctioned            RepossessionCase[]     @relation("RepoAuctioned")
  reposCancelled            RepossessionCase[]     @relation("RepoCancelled")
  dorsiTagged               DorsiRecord[]          @relation("DorsiTaggedBy")
  dorsiReviewed             DorsiRecord[]          @relation("DorsiReviewedBy")
  dorsiDeactivated          DorsiRecord[]          @relation("DorsiDeactivatedBy")
  dorsiBoardApproved        DorsiBoardApproval[]   @relation("DorsiBoardApprovedBy")
  systemConfigUpdates       SystemConfig[]         @relation("SystemConfigUpdatedBy")
  leaseBuyouts              LeaseAgreement[]       @relation("LeaseBuyoutBy")
  leasePulledOut            LeaseAgreement[]       @relation("LeasePulledOutBy")
  /// Wizard drafts owned by this user. Cascade-delete because drafts
  /// are throwaway work-in-progress; nothing else references them.
  loanDrafts                LoanDraft[]            @relation("LoanDraftAuthor")
  licensesActivated         License[]              @relation("LicenseActivatedBy")
  licensesRevoked           License[]              @relation("LicenseRevokedBy")

  // A customer may have a linked self-serve User account
  customer   Customer? @relation("CustomerLogin", fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?   @unique
}

// ─── Customers (borrowers) — full KYC profile ────────────────────────────────

enum GovernmentIdType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  SSS
  TIN
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  /// Project / contract worker — treated like SELF_EMPLOYED for income
  /// verification, but kept separate so reports can break it out.
  FREELANCE
  UNEMPLOYED
  RETIRED
  STUDENT
}

/// Self-identified gender. Distinct from `sex` (biological) below so
/// the form can collect both correctly per modern PH practice.
enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Sex {
  MALE
  FEMALE
  INTERSEX
}

/// Civil status. Annulled is distinct from divorced in PH law.
enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  ANNULLED
  DIVORCED
}

enum KycStatus {
  /// No KYC submitted yet
  NONE
  /// Documents submitted, waiting for review
  PENDING
  /// All required docs verified
  VERIFIED
  /// At least one doc was rejected; customer must resubmit
  REJECTED
}

model Customer {
  id     String @id @default(uuid())
  /// Human-readable: "CUST-2026-000123". Used in URLs and operator UI
  /// in place of the UUID. Generated by CustomerRepository.nextNumber()
  /// at create time; backfilled on existing rows by the
  /// 20260521_customer_number migration.
  number String @unique

  // ── Personal ─────────────────────────────────────────────────────
  firstName   String
  middleName  String?
  lastName    String
  /// Generational suffix (Jr, Sr, III, IV). Optional; many borrowers
  /// don't have one.
  suffix      String?
  dateOfBirth DateTime
  /// Self-identified gender. Nullable for legacy rows;
  /// new applications collect it at registration.
  gender      Gender?
  /// Biological sex — collected separately because some compliance
  /// reports require it and not all borrowers want them to match.
  sex         Sex?
  civilStatus CivilStatus?

  // ── Contact ──────────────────────────────────────────────────────
  /// Primary mobile number. Originally just "phone" — kept the column
  /// name for back-compat; the UI now labels it as "Primary phone".
  phone          String
  /// Optional secondary number (landline, alt mobile).
  secondaryPhone String?
  email          String?

  // ── Address (expanded for PH PSGC hierarchy) ─────────────────────
  /// Free-form street + house/unit number. Originally "address";
  /// renamed semantically to addressLine1 for the new fields below.
  /// DB column stays "address" so we don't churn historical data.
  address      String
  /// Subdivision, building, floor — optional second line.
  addressLine2 String?
  /// Barangay (smallest PH admin unit). Required for KYC compliance.
  barangay     String?
  city         String
  province     String?
  /// PH region (e.g. NCR, Region IV-A CALABARZON). Used in compliance
  /// reports and risk segmentation.
  region       String?
  postalCode   String?

  // ── Civil status + spouse (only when MARRIED) ────────────────────
  // Kept as flat fields rather than a relation — spouses are usually
  // not borrowers themselves and don't need their own Customer row.
  spouseName        String?
  spouseDateOfBirth DateTime?
  spouseContact     String?
  spouseOccupation  String?

  // ── Government ID ────────────────────────────────────────────────
  governmentIdType   GovernmentIdType
  governmentIdNumber String

  // ── Employment + income ──────────────────────────────────────────
  employmentStatus   EmploymentStatus
  /// For EMPLOYED / SELF_EMPLOYED / FREELANCE.
  employerName       String?
  jobTitle           String?
  /// Department / designation distinct from jobTitle (e.g. job title
  /// "Senior Developer", position "Engineering Lead").
  position           String?
  /// PH labour milestone — date of regularization. Lenders treat
  /// regularized employees as lower-risk than probationary.
  hireDate           DateTime?
  regularizationDate DateTime?
  /// Verified monthly income in the system's home currency
  monthlyIncome      Decimal          @db.Decimal(14, 2)
  yearsAtCurrentJob  Decimal?         @db.Decimal(5, 2)

  // Computed KYC rollup (latest)
  kycStatus KycStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// GDPR / Data Privacy Act marker. Non-null = this row has had its
  /// PII fields overwritten with deterministic placeholders by the
  /// compliance service. Foreign keys to financial records (loans,
  /// journal entries) still resolve to this id, but the human-readable
  /// fields are gone. Set only by the compliance service; once
  /// non-null, must never revert to null without a court order +
  /// manual ops procedure.
  erasedAt   DateTime?
  /// User id of whoever ran the erasure. NOT a foreign key — the
  /// referenced operator may themselves leave the org while erased
  /// rows remain on file (typical retention is 5–10 years).
  erasedById String?

  user             User?             @relation("CustomerLogin")
  kycSubmissions   KycSubmission[]
  loanApplications LoanApplication[]
  /// Loans this customer stands as CO-MAKER on. Distinct from
  /// `loanApplications`, which is the debt that is theirs. Same
  /// person, two very different kinds of liability, and the
  /// exposure question needs both.
  coMakerFor       CoMaker[]         @relation("CustomerCoMakerFor")
  surveyResponses  SurveyResponse[]
  creditScores     CreditScore[]
  amlScreenings    AmlScreening[]
  dorsiRecord      DorsiRecord?
  preAssessments   PreAssessment[]

  // ── Cooperative-side activity (contributions, savings, fund movements). ──
  // A customer-borrower is also a coop member; these relations let the
  // same record show their loans AND their CBU/Mortuary/Emergency balances.
  contributions   Contribution[]
  savingsTxns     SavingsTransaction[]
  fundTxns        FundTransaction[]
  fundWithdrawals FundWithdrawal[]

  @@index([phone])
  @@index([governmentIdType, governmentIdNumber])
  @@index([erasedAt])
}

// ─── KYC document submissions ────────────────────────────────────────────────

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  PROOF_OF_INCOME // payslip, ITR, COE
  PROOF_OF_ADDRESS // utility bill
  SELFIE // for face match
  VEHICLE_OR // Official Receipt (vehicle)
  VEHICLE_CR // Certificate of Registration (vehicle)
  PROPERTY_TITLE // TCT / Condo title
  TAX_DECLARATION // Tax dec for property
}

enum KycSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

model KycSubmission {
  id           String              @id @default(uuid())
  /// Human-readable: "KYC-2026-000123". Shown in URLs/UI in place of UUID.
  number       String              @unique
  customerId   String
  documentType KycDocumentType
  /// /uploads/kyc/<random>.jpg — served by API static plugin
  documentUrl  String
  status       KycSubmissionStatus @default(PENDING)
  notes        String?
  /// Why it was rejected, if applicable
  reason       String?
  submittedAt  DateTime            @default(now())
  decidedAt    DateTime?

  submittedById String
  decidedById   String?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  submittedBy User     @relation("KycSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?    @relation("KycDecidedBy", fields: [decidedById], references: [id])

  @@index([customerId, documentType])
  @@index([status])
}

// ─── Credit scoring ──────────────────────────────────────────────────────────
//
// `CreditScore` is the latest computed snapshot — recomputed whenever the
// customer fills the survey or significant behavioral data changes (loan
// approved, payment made, default flagged). The `breakdown` JSON carries
// per-factor contributions so the customer-facing "why this score?" page
// can render an honest explanation.

enum CreditTier {
  A // 750+ "excellent" — auto-approve eligible
  B // 700–749 "good"
  C // 600–699 "fair"
  D // 500–599 "poor"
  F // <500 "very poor" — auto-reject candidates
}

model CreditScore {
  id             String     @id @default(uuid())
  customerId     String
  /// Numeric score, FICO-flavored range (300–850). See @loan/credit-scoring.
  score          Int
  tier           CreditTier
  /// Per-factor explanation: `[{ factor, weight, value, points }, …]`
  breakdown      Json
  /// Link to the survey that produced this score, when one applies
  sourceSurveyId String?
  computedAt     DateTime   @default(now())

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source   SurveyResponse? @relation(fields: [sourceSurveyId], references: [id], onDelete: SetNull)

  @@index([customerId, computedAt(sort: Desc)])
}

// ─── Credit survey (multi-step questionnaire) ────────────────────────────────
//
// Each `SurveyResponse` is the full set of answers submitted at one time.
// The catalog of questions itself lives in code (@loan/credit-scoring) so
// it's typed and easy to evolve; only the answers are persisted.

model SurveyResponse {
  id           String     @id @default(uuid())
  customerId   String
  /// `{ questionId: answer, … }` — values are string|number|boolean
  answers      Json
  /// Computed score from these answers at submission time
  score        Int
  tier         CreditTier
  /// Per-factor explanation (same shape as CreditScore.breakdown)
  breakdown    Json
  computedAt   DateTime   @default(now())
  computedById String

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  computedBy   User          @relation("SurveyComputedBy", fields: [computedById], references: [id])
  creditScores CreditScore[]

  @@index([customerId, computedAt(sort: Desc)])
}

// ─── Scoring catalog (admin-editable credit survey) ─────────────────────────
//
// The factor list and survey questions used to be constants in
// @loan/credit-scoring. They're rows now so an admin can tune the survey
// per deployment — but the SCALE is not editable. Factors carry a
// relative `weight`; the lib normalizes those onto a fixed 150-point
// total, so adding a factor redistributes points rather than moving the
// 300–850 scale. A 720 means the same thing before and after an edit,
// and decision rules that threshold on score keep their meaning.
//
// Seeded from the shipped catalog, so a fresh deployment scores exactly
// as it did before the catalog became editable.

enum SurveyQuestionKind {
  /// Pick one option; each option carries its own weight.
  CHOICE
  /// Numeric input mapped linearly from min..max onto 0..1.
  NUMBER
  /// Yes/no; `true` contributes weightWhenTrue, `false` contributes 0.
  BOOLEAN
}

model SurveyFactor {
  id       String  @id @default(uuid())
  /// Stable identifier referenced by questions AND by stored score
  /// breakdowns ("income", "on_time"). Renaming the label is safe;
  /// changing this orphans historical breakdowns, so the API refuses.
  key      String  @unique
  label    String
  /// Relative share of the fixed total. Any positive number — only the
  /// ratio between factors matters, so 25/20 and 5/4 are identical.
  weight   Float
  /// Derived from loan history rather than a survey answer (on-time
  /// rate, defaults). Still consumes points, so it normalizes like any
  /// other factor, but the builder doesn't offer questions for it.
  computed Boolean @default(false)
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions SurveyQuestionDef[]

  @@index([order])
}

model SurveyQuestionDef {
  id       String             @id @default(uuid())
  /// Stable identifier answers key on. SurveyResponse.answers is
  /// `{ [key]: answer }`, so this is as immutable as the factor key.
  key      String             @unique
  kind     SurveyQuestionKind
  label    String
  help     String?
  /// Free-text grouping heading, same convention as KYC declarations.
  category String?
  order    Int                @default(0)
  active   Boolean            @default(true)

  /// Kind-specific configuration:
  ///   CHOICE  → { options: [{ label, value, weight }] }
  ///   NUMBER  → { min, max, step?, inverted? }
  ///   BOOLEAN → { weightWhenTrue }
  /// JSON because the three shapes share nothing; the API validates
  /// per-kind with a discriminated zod union.
  config Json

  factorId String
  /// Cascade: a factor's questions are meaningless without it, and the
  /// API blocks deleting a factor that still has any.
  factor   SurveyFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factorId])
  @@index([order])
}

// ─── Loans (application → approved → disbursed → active → closed) ───────────

enum LoanStatus {
  DRAFT // not yet submitted
  SUBMITTED // waiting for officer review
  UNDER_REVIEW // officer picked it up
  APPROVED // approved but not yet disbursed
  REJECTED // declined; terminal
  DISBURSED // funds released; payment schedule active
  ACTIVE // alias for in-repayment (kept distinct so reporting is easier)
  CLOSED // fully paid; terminal
  DEFAULTED // missed too many payments; terminal-ish
  CANCELLED // customer cancelled before approval
  RESTRUCTURED // replaced by a new loan; terminal on the original
  WRITTEN_OFF // lender gave up collecting; principal hits Bad Debt; terminal
}

// ─── Loan products (product catalog) ─────────────────────────────────────────
//
// Products are fully dynamic — the catalog is rows, not enum values. Admin can
// create new products at runtime. `code` is the stable identifier referenced
// by every LoanApplication.

enum CollateralKind {
  NONE
  VEHICLE
  PROPERTY
}

enum CollateralStatus {
  /// Submitted with the application, not yet verified
  PROPOSED
  /// Officer verified ownership docs (OR/CR, title)
  VERIFIED
  /// Loan closed, lien released
  RELEASED
  /// Foreclosed / repossessed
  SEIZED
}

/**
 * In-progress loan application — pre-submit. Officers fill the wizard
 * across multiple sessions; the form state is snapshotted here so they
 * can resume from any device. On final Submit the draft is consumed
 * into a real LoanApplication via /loans/apply and this row is deleted.
 * Design notes:
 * - `formState` is a JSON blob owned by the web app's wizard. We
 * intentionally don't strongly type it server-side — the wizard
 * evolves, the persisted shape comes along. Final-submit validation
 * happens against the canonical LoanApplyInput zod schema.
 * - Drafts are scoped per-author. An ADMIN sees their own drafts
 * only via /loans/drafts; there's no "see all drafts" surface.
 * - Cascade-delete on author so a deactivated user doesn't leave
 * orphan drafts haunting the table.
 * - `customerId` + `productCode` are lifted out of formState to make
 * listing efficient (no JSON path queries needed for the drafts list).
 */
model LoanDraft {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("LoanDraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Selected customer, null while officer is still on step 1.
  customerId  String?
  /// Selected product code, null while officer is still on step 2.
  productCode String?
  /// Last step the officer was on (0-based). Drives resume positioning.
  lastStep    Int      @default(0)
  /// Free-form snapshot of the wizard form state. Owned by apps/web.
  formState   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, updatedAt(sort: Desc)])
}

/**
 * Per-product configuration. Limits, defaults, and required docs.
 * One row per LoanType. Admin-tunable without a code change.
 */
model LoanProduct {
  id              String            @id @default(uuid())
  /// Stable identifier referenced by LoanApplication.productCode.
  /// Conventionally uppercase snake (e.g. "SALARY", "EDUCATIONAL", "BUSINESS_SME").
  code            String            @unique
  name            String
  description     String?
  collateralKind  CollateralKind    @default(NONE)
  /// Doc types required ON TOP OF the base KYC pack for this product.
  requiredKycDocs KycDocumentType[]

  /// Per-product KYC declaration questionnaire, admin-built. JSON array
  /// of `{ id, label, type, options?, required, hint? }` — see
  /// @loan/kyc's KycQuestion. Null/empty = no questionnaire: the product
  /// asks nothing and gates nothing. Answers are snapshotted onto
  /// LoanApplication.kycDeclarations, so editing this never rewrites
  /// what an applicant already attested to.
  kycQuestions Json?

  minPrincipal   Decimal  @db.Decimal(14, 2)
  maxPrincipal   Decimal  @db.Decimal(14, 2)
  minTermMonths  Int
  maxTermMonths  Int
  /// Annual rate as decimal: 0.18 = 18%/year
  defaultRate    Decimal  @db.Decimal(6, 4)
  minRate        Decimal  @db.Decimal(6, 4)
  maxRate        Decimal  @db.Decimal(6, 4)
  /// Maximum loan-to-value for secured loans (0.80 = 80% of appraised value).
  /// Null for unsecured products. Per-tier overrides via `ltvByTier` take precedence.
  maxLoanToValue Decimal? @db.Decimal(5, 4)

  // ── Fees ────────────────────────────────────────────────────────────
  /// One-time processing fee, percent of principal (0.02 = 2%).
  processingFeeRate     Decimal @default(0) @db.Decimal(5, 4)
  /// One-time processing fee, flat amount in PHP. Added on top of rate-based.
  processingFeeFlat     Decimal @default(0) @db.Decimal(14, 2)
  /// Documentary stamp tax, percent of principal (PH default ≈ 1.5/200 = 0.0075).
  documentaryStampRate  Decimal @default(0) @db.Decimal(5, 4)
  /// Daily late-fee rate, percent of installment (0.01 = 1%/day).
  lateFeeDailyRate      Decimal @default(0.01) @db.Decimal(5, 4)
  /// Late-fee cap as fraction of installment (0.1 = 10%).
  lateFeeCapFraction    Decimal @default(0.1) @db.Decimal(5, 4)
  /// Free days after due date before fees accrue.
  lateFeeGraceDays      Int     @default(3)
  /// Pre-termination fee, percent of remaining principal at close.
  preTerminationFeeRate Decimal @default(0) @db.Decimal(5, 4)

  // ── Interest method + frequency ────────────────────────────────────
  interestMethod   InterestMethod   @default(DECLINING)
  paymentFrequency PaymentFrequency @default(MONTHLY)

  // ── Tier-based pricing (optional) ──────────────────────────────────
  /// JSON map of credit tier → rate. Format: { "A": 0.08, "B": 0.10, … }
  /// If set, apply uses tierAtApply to look up the rate.
  /// A tier mapped to `null` means rejected for this product.
  rateByTier Json?
  /// JSON map of credit tier → max LTV. Format: { "A": 0.80, "B": 0.70, … }
  /// Overrides `maxLoanToValue` when set.
  ltvByTier  Json?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── ECL provisioning (IFRS 9 / PFRS 9) ─────────────────────────────
  /// Probability of default — 12-month for Stage 1, lifetime for Stage 2/3.
  /// Decimal in [0,1]. Default 0.05 is a placeholder; tune per cohort.
  eclPd12m      Decimal @default(0.05) @db.Decimal(6, 4)
  eclPdLifetime Decimal @default(0.20) @db.Decimal(6, 4)
  /// Loss given default — fraction of EAD expected to be lost net of
  /// recoveries. 0.45 is a typical PH NBFI baseline for unsecured retail.
  eclLgd        Decimal @default(0.45) @db.Decimal(6, 4)

  // ── Lease-to-Own ───────────────────────────────────────────────────
  /// When true, applications create a LeaseAgreement at disburse. Vehicle
  /// title stays with the company until the borrower pays the residual.
  isLease                   Boolean  @default(false)
  /// Default residual value as a fraction of principal (0.10 = 10%).
  /// A LEASE_AUTO product with 600k principal + 0.10 = 60k buyout fee.
  /// Per-loan override is captured on LeaseAgreement at create time.
  residualValueFraction     Decimal? @db.Decimal(5, 4)
  /// True when the product is restricted to company employees (
  /// currently the case; non-employees come in a future phase).
  employeeOnly              Boolean  @default(false)
  /// Number of consecutive missed payments before non-employees lose
  /// possession. Defaults to 3.
  missedPaymentPullOutCount Int      @default(3)
  /// Months between maintenance reminders (every 6 months).
  maintenanceReminderMonths Int      @default(6)

  loans         LoanApplication[]
  /// Approval-chain steps for this product, ordered by `order`. Empty = no
  /// chain configured; the legacy single-decide flow applies.
  approvalSteps LoanApprovalStep[]
}

// ─── Loan approval chain (per product) ──────────────────────────────────────
//
// A loan product can declare a sequential approval chain — e.g. for an Auto
// loan it might be Officer → Branch Manager → Credit Committee. Each step
// names a `requiredPermission` so RBAC (and the existing Delegation feature)
// decides who can act on it. When a loan is submitted under a product with
// a chain, one LoanApproval row is created per step; the loan stays at
// status=SUBMITTED until all steps complete, then flips to APPROVED.
//
// If a product has zero steps, the legacy `LoanRepository.decide()` flow
// still works — back-compat for products that never get a chain.

model LoanApprovalStep {
  id                 String   @id @default(uuid())
  productCode        String
  /// 1-indexed step position in the chain. Unique per product.
  order              Int
  /// Human label shown in the UI ("Branch Manager review",
  /// "Credit Committee sign-off"). Frozen onto LoanApproval rows at
  /// loan-submit time so historical loans don't drift if labels change.
  label              String
  /// Permission key the actor must hold (directly or via Delegation) to
  /// approve this step. e.g. "loans.approve.bm".
  requiredPermission String
  /// Optional steps can be skipped by anyone who would otherwise approve.
  /// Today reserved for future use — defaults to false.
  optional           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product LoanProduct @relation(fields: [productCode], references: [code], onDelete: Cascade)

  @@unique([productCode, order])
  @@index([productCode])
}

enum LoanApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model LoanApproval {
  id                 String @id @default(uuid())
  loanId             String
  /// Position in the chain (1-indexed). Copied from LoanApprovalStep at
  /// loan-submit time.
  stepOrder          Int
  /// Frozen at loan-submit so audits read sensibly even if the product's
  /// chain was edited later.
  stepLabel          String
  /// Permission needed to act on this step (frozen at submit).
  requiredPermission String

  status                  LoanApprovalStatus @default(PENDING)
  /// Free-form note left by the approver. Optional — empty when the user
  /// approves without commentary.
  notes                   String?
  approverId              String?
  approvedAt              DateTime?
  /// When the approver acted under a Delegation. Lets audit reports
  /// distinguish "Manager approved themselves" vs "Officer approved as
  /// stand-in while Manager was on leave".
  signedUnderDelegationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan       LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  approver   User?           @relation("LoanApprover", fields: [approverId], references: [id])
  delegation Delegation?     @relation("LoanApprovalDelegation", fields: [signedUnderDelegationId], references: [id], onDelete: SetNull)

  @@unique([loanId, stepOrder])
  @@index([loanId, status])
  @@index([approverId])
}

enum InterestMethod {
  /// Standard amortization — interest computed on remaining balance each period.
  DECLINING
  /// Add-on / flat — interest pre-calculated on full principal, split evenly.
  /// Common for short-term personal loans in PH.
  FLAT
}

enum PaymentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

// ─── Collateral (typed per kind) ─────────────────────────────────────────────

model Vehicle {
  id             String           @id @default(uuid())
  /// Human-readable: "VEH-000123" — surfaced in operator UI.
  number         String           @unique
  /// 'CAR' or 'MOTORCYCLE' — finer than LoanType, kept loose for future kinds.
  kind           String
  make           String
  model          String
  year           Int
  plateNumber    String?
  chassisNumber  String?
  engineNumber   String?
  color          String?
  /// Appraised value used for LTV computation.
  appraisedValue Decimal          @db.Decimal(14, 2)
  status         CollateralStatus @default(PROPOSED)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  loan LoanApplication?
}

model Property {
  id             String           @id @default(uuid())
  /// Human-readable: "PROP-000123" — surfaced in operator UI.
  number         String           @unique
  /// 'HOUSE_AND_LOT' | 'CONDO' | 'LOT_ONLY' | 'COMMERCIAL' | …
  propertyType   String
  address        String
  city           String
  province       String?
  postalCode     String?
  /// Land title (TCT) or condo certificate number
  titleNumber    String?
  taxDecNumber   String?
  /// In square meters
  areaSqm        Decimal?         @db.Decimal(10, 2)
  appraisedValue Decimal          @db.Decimal(14, 2)
  status         CollateralStatus @default(PROPOSED)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  loan LoanApplication?
}

model LoanApplication {
  id         String @id @default(uuid())
  /// Human-readable: "LN-2026-000123"
  number     String @unique
  customerId String

  /// FK to LoanProduct.code. Legacy rows are backfilled to "SALARY".
  productCode String      @default("SALARY")
  product     LoanProduct @relation(fields: [productCode], references: [code], onDelete: Restrict)

  /// URL of the live-capture selfie taken at apply. Used for face-match
  /// against ID_FRONT KYC doc + as a fraud signal.
  applicationSelfieUrl String?

  /// Face-match outputs. Populated when an officer (or background job)
  /// runs the browser-local face-api.js compare between the application
  /// selfie and the customer's verified ID_FRONT photo.
  ///
  /// `selfieMatchScore`     — normalized similarity 0..1, higher = better.
  /// `selfieMatchDistance`  — raw Euclidean distance from face-api.js
  ///                          (lower = better; conventional same-person
  ///                          threshold is ~0.6).
  /// `selfieMatchPassed`    — true when score ≥ 0.55. Drives the green
  ///                          / amber badge on the loan detail page.
  /// `selfieMatchModel`     — identifies the model used for reproducibility
  ///                          (e.g. "face-api/1.7.13/ssd-mobilenetv1").
  /// `selfieMatchedAt`      — wall-clock time the match was computed.
  selfieMatchScore    Float?
  selfieMatchDistance Float?
  selfieMatchPassed   Boolean?
  selfieMatchModel    String?
  selfieMatchedAt     DateTime?

  /// If this loan restructured an older one, the original loan's id.
  /// Mutually exclusive with `restructuredById`. Kept on the new loan so
  /// the timeline is easy to walk forward.
  restructuredFromId String?          @unique
  restructuredFrom   LoanApplication? @relation("Restructure", fields: [restructuredFromId], references: [id])
  restructuredBy     LoanApplication? @relation("Restructure")

  /// True if the customer had a prior fully-paid loan when this application
  /// was submitted ("Repeat Loan"). Set automatically at apply
  /// time; treated as a hint by the underwriter, not a hard gate.
  isRepeat Boolean @default(false)

  /// Write-off bookkeeping. `writeOffAmount` is whatever principal remained
  /// outstanding at the time of write-off (what we Dr'd Bad Debt for).
  writeOffAmount Decimal?  @db.Decimal(14, 2)
  writeOffReason String?
  writtenOffAt   DateTime?
  writtenOffById String?

  // ── E-signature audit trail ──────────────────────────────────────────
  /// URL of the borrower's captured signature PNG (typically /uploads/signatures/<id>.png).
  borrowerSignatureUrl           String?
  borrowerSignedAt               DateTime?
  /// Source IP at signing — captured for audit. May be IPv6.
  borrowerSignedFromIp           String?
  officerSignatureUrl            String?
  officerSignedAt                DateTime?
  officerSignedById              String?
  /// If the officer signed under delegation, the Delegation id. Lets the
  /// PDF render "Signed by X under delegation from Y".
  officerSignedUnderDelegationId String?
  officerSignedUnderDelegation   Delegation? @relation("OfficerSignedUnderDelegation", fields: [officerSignedUnderDelegationId], references: [id], onDelete: SetNull)

  /// IFRS 9 expected-credit-loss staging.
  ///   STAGE_1 = performing            → 12-month ECL
  ///   STAGE_2 = significant increase  → lifetime ECL (no default yet)
  ///   STAGE_3 = credit-impaired       → lifetime ECL, individual treatment
  /// Updated by the periodic ECL job based on DPD + risk signals; never
  /// edited directly by hand.
  eclStage      EclStage  @default(STAGE_1)
  /// Most recent computed ECL amount in PHP. Snapshot only — the
  /// authoritative history lives in EclRun.
  eclProvision  Decimal?  @db.Decimal(18, 2)
  eclComputedAt DateTime?

  /// SHA-256 of the agreement PDF as rendered at signing time. Lets us
  /// detect whether the document was tampered with after signature.
  agreementHash String?

  // Terms requested
  principal          Decimal @db.Decimal(14, 2)
  termMonths         Int
  /// Annual rate as decimal: 0.18 = 18%/year
  annualInterestRate Decimal @db.Decimal(6, 4)
  purpose            String?

  // Underwriting context — frozen at application time
  creditScoreAtApply Int?
  tierAtApply        CreditTier?

  /// Snapshot of the product's KYC declaration questionnaire + answers
  /// as attested: `{ items: [{id,label,type,required,answer}],
  /// answeredAt, answeredById }`. Snapshot, not reference — the admin
  /// can rewrite the questionnaire tomorrow and this record must not
  /// rewrite itself with it. Null when the product had no questionnaire
  /// at apply time. Approval gates on THIS snapshot's completeness.
  kycDeclarations Json?

  status         LoanStatus @default(SUBMITTED)
  decisionReason String?

  /// Current step in the approval chain (1-indexed). Null when:
  ///   • the product has no chain configured (legacy single-decide),
  ///   • or all steps have completed and loan.status flipped past SUBMITTED.
  /// Bumped by LoanApprovalRepository.approveStep() as each step lands.
  currentApprovalStep Int?

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  disbursedAt DateTime?
  closedAt    DateTime?

  submittedById String
  decidedById   String?
  disbursedById String?

  // Optional collateral. At most one of these is populated, gated by product.
  vehicleId  String?   @unique
  propertyId String?   @unique
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  submittedBy User     @relation("LoanSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?    @relation("LoanDecidedBy", fields: [decidedById], references: [id])
  disbursedBy User?    @relation("LoanDisbursedBy", fields: [disbursedById], references: [id])

  schedule             LoanSchedule[]
  payments             LoanPayment[]
  collectionNotes      CollectionNote[]
  promisesToPay        PromiseToPay[]
  paymentIntents       PaymentIntent[]
  coMakers             CoMaker[]
  messages             LoanMessage[]
  penaltyWaivers       PenaltyWaiver[]
  annualDocuments      AnnualDocument[]
  demandLetters        DemandLetter[]
  repossessionCase     RepossessionCase?
  dorsiBoardApproval   DorsiBoardApproval?
  collectionAssignment CollectionAssignment?
  leaseAgreement       LeaseAgreement?
  approvals            LoanApproval[]
  /// The pre-assessment this application was converted from, if any.
  preAssessment        PreAssessment?

  @@index([customerId, status])
  @@index([status, submittedAt])
  @@index([productCode])
}

// ─── Amortization schedule + actual payments ────────────────────────────────
//
// One `LoanSchedule` row per scheduled installment (monthly). `LoanPayment`
// rows are actual money received; the repository ties them back to the
// next-due schedule row at payment time.

model LoanSchedule {
  id            String    @id @default(uuid())
  loanId        String
  /// 1-indexed installment number
  installmentNo Int
  dueDate       DateTime
  /// Principal portion of this installment
  principalDue  Decimal   @db.Decimal(14, 2)
  /// Interest portion of this installment
  interestDue   Decimal   @db.Decimal(14, 2)
  /// `principalDue + interestDue`
  totalDue      Decimal   @db.Decimal(14, 2)
  /// Principal collected on THIS installment so far (0 .. principalDue).
  /// Written by every payment, not only the one that settles the row —
  /// this is what makes repeated partial payments accumulate correctly.
  principalPaid Decimal   @default(0) @db.Decimal(14, 2)
  /// Interest collected on THIS installment so far (0 .. interestDue).
  /// Payment allocation runs against `interestDue - interestPaid`; without
  /// it every partial payment would re-recognize the same interest income.
  interestPaid  Decimal   @default(0) @db.Decimal(14, 2)
  /// Set once `principalPaid >= principalDue AND interestPaid >= interestDue`.
  paidInFullAt  DateTime?

  loan LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNo])
  @@index([dueDate])
}

model LoanPayment {
  id           String   @id @default(uuid())
  loanId       String
  amount       Decimal  @db.Decimal(14, 2)
  paidOn       DateTime @default(now())
  reference    String?
  /// Free-form note (e.g. "settled via GCash REF abc123")
  notes        String?
  recordedById String

  loan       LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recordedBy User            @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  intent     PaymentIntent?

  @@index([loanId, paidOn(sort: Desc)])
}

// ─── Accounting (general ledger, double-entry) ───────────────────────────────
//
// We keep books "right beside" the loan domain so disbursements and payments
// post journal entries inside the same Prisma transaction. The ledger is
// append-only: corrections happen via reversing entries, never edits.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model Account {
  id            String        @id @default(uuid())
  /// Numeric account code, e.g. "1100" — sorts lexically in standard order.
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance
  description   String?
  active        Boolean       @default(true)
  /// System accounts are referenced by code from auto-posting code and
  /// cannot be deleted (they may be deactivated only by an admin).
  system        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines JournalLine[]

  @@index([type])
  @@index([code])
}

enum JournalSource {
  /// An accountant typed it in by hand.
  MANUAL
  /// Auto-posted by LoanRepository.disburse.
  LOAN_DISBURSEMENT
  /// Auto-posted by LoanRepository.recordPayment.
  LOAN_PAYMENT
  /// Reversing entry to back out a prior entry.
  REVERSAL
  /// Period-end adjusting entry.
  ADJUSTMENT
  /// Monthly interest accrual (Dr Interest Receivable / Cr Interest Income).
  INTEREST_ACCRUAL
  /// Daily late-fee accrual on overdue installments.
  LATE_FEE_ACCRUAL
  /// Period-end ECL allowance movement — DR Impairment Loss / CR Allowance
  /// for Doubtful Accounts (or the reverse for write-backs). Posted by the
  /// ECL run job; tagged by EclRun id for idempotency.
  ECL_PROVISION
  /// Cooperative module posts — keep them grouped at the bottom so the
  /// JournalSource UI filters can offer a "Cooperative" preset.
  COOP_CONTRIBUTION
  COOP_SAVINGS
  COOP_FUND_IN
  COOP_FUND_OUT
  COOP_EXPENSE
  COOP_OTHER_INCOME
  COOP_BIG_BROTHER
  /// Penalty waive — partially or fully reverses a prior LATE_FEE_ACCRUAL
  /// (DR Fee Income / CR Loans Receivable). Tracked via PenaltyWaiver.
  PENALTY_WAIVE
  /// Repossession auction settlement — applies proceeds to the loan and
  /// books any deficiency as bad debt. Tracked via RepossessionCase.
  REPOSSESSION_AUCTION
  /// Lease-to-own residual buyout — borrower paid the residual fee at end
  /// of lease term, title transfers to borrower.
  LEASE_BUYOUT
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// One row per (year, month). Once CLOSED, no postings can hit it
/// (caller must reopen first). Year-end close is just December close.
model AccountingPeriod {
  id         String       @id @default(uuid())
  year       Int
  month      Int // 1–12
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  entries JournalEntry[]

  @@unique([year, month])
  @@index([status])
}

model JournalEntry {
  id            String        @id @default(uuid())
  /// Human-readable: "JE-2026-000123"
  number        String        @unique
  /// Date the entry affects the books (may differ from postedAt).
  entryDate     DateTime
  memo          String?
  source        JournalSource @default(MANUAL)
  /// For auto-posted entries: the originating loan/payment id, so we
  /// can detect duplicates and link from the loan detail page.
  sourceRefType String?
  sourceRefId   String?

  postedAt   DateTime @default(now())
  postedById String

  /// The accounting period this entry hit. Resolved from entryDate at
  /// post time. Nullable for legacy entries that pre-date the periods table.
  periodId String?
  period   AccountingPeriod? @relation(fields: [periodId], references: [id])

  /// If this entry was reversed, the id of the reversing entry.
  reversedById String?       @unique
  reversedBy   JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reverses     JournalEntry? @relation("JournalReversal")

  postedBy          User               @relation("JournalPostedBy", fields: [postedById], references: [id])
  lines             JournalLine[]
  penaltyWaivers    PenaltyWaiver[]
  repossessionCases RepossessionCase[]
  leaseAgreements   LeaseAgreement[]

  @@index([entryDate])
  @@index([source, sourceRefId])
  @@index([sourceRefType, sourceRefId])
  @@index([periodId])
}

model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  accountId String
  /// Debit amount (mutually exclusive with credit — one of these is 0).
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

// ─── Collections (overdue follow-up workflow) ────────────────────────────────

enum CollectionNoteType {
  CALL
  SMS
  EMAIL
  VISIT
  OTHER
}

model CollectionNote {
  id          String             @id @default(uuid())
  loanId      String
  type        CollectionNoteType @default(OTHER)
  body        String
  createdAt   DateTime           @default(now())
  createdById String

  loan      LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CollectionNoteBy", fields: [createdById], references: [id])

  @@index([loanId, createdAt(sort: Desc)])
}

enum PromiseStatus {
  /// Customer committed to a future payment.
  PROMISED
  /// They paid on or before the promise date.
  HONORED
  /// Promise date passed without payment.
  BROKEN
  /// Cancelled by the customer or officer.
  CANCELLED
}

model PromiseToPay {
  id           String        @id @default(uuid())
  loanId       String
  amount       Decimal       @db.Decimal(14, 2)
  promisedDate DateTime
  status       PromiseStatus @default(PROMISED)
  note         String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  createdById  String

  loan      LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdBy User            @relation("PtpCreatedBy", fields: [createdById], references: [id])

  @@index([loanId, promisedDate])
  @@index([status])
}

/// Who owns a delinquent account.
///
/// The collections queue is derived, not stored — it's every active loan
/// with an unpaid installment past due, recomputed on each request. That
/// works as a shared worklist but gives nobody ownership: no "my
/// accounts", no handover trail, nothing to measure a collector against.
/// This is the missing piece, and it hangs off the loan rather than off a
/// case record because there is no case record to hang it off.
///
/// `loanId` is unique: a loan has exactly one current owner. Reassignment
/// overwrites the row rather than appending, and the audit log carries the
/// history — duplicating it here would be a second, driftable record of
/// the same event.
///
/// The row deliberately survives the account curing. A loan that falls
/// behind again lands back with the collector who already knows it, and
/// deleting on cure would throw that context away; the queue filters on
/// delinquency anyway, so a cured account simply stops appearing.
model CollectionAssignment {
  id           String   @id @default(uuid())
  loanId       String   @unique
  /// User the account is assigned to. Not constrained to the COLLECTOR
  /// role — officers and admins work accounts too, and a role check at
  /// write time is the API's job, not the schema's.
  collectorId  String
  assignedById String
  assignedAt   DateTime @default(now())
  /// Optional handover context, e.g. "borrower speaks Ilocano" or
  /// "escalated from Ana — promised to pay twice, broke both".
  note         String?

  loan       LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  collector  User            @relation("CollectionAssignedTo", fields: [collectorId], references: [id], onDelete: Cascade)
  assignedBy User            @relation("CollectionAssignedBy", fields: [assignedById], references: [id])

  @@index([collectorId])
}

// ─── Payment gateway (provider-agnostic intents + webhook trail) ─────────────

enum PaymentProvider {
  MOCK
  GCASH
  MAYA
}

enum PaymentIntentStatus {
  CREATED
  PROCESSING
  PAID
  FAILED
  EXPIRED
}

model PaymentIntent {
  id             String              @id @default(uuid())
  /// Human-readable: "PI-2026-000123" — surfaced in URLs/UI.
  number         String              @unique
  loanId         String
  provider       PaymentProvider     @default(MOCK)
  /// Provider-side id (e.g. "ch_abc123" or "mock_...").
  externalId     String
  /// Idempotency key the API supplied at create; safe to retry.
  idempotencyKey String              @unique
  amount         Decimal             @db.Decimal(14, 2)
  paymentUrl     String
  status         PaymentIntentStatus @default(CREATED)
  /// When status flipped to PAID/FAILED/EXPIRED.
  resolvedAt     DateTime?
  /// If PAID, link to the LoanPayment row that recorded it.
  paymentId      String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdById    String

  loan      LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payment   LoanPayment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User            @relation("PaymentIntentBy", fields: [createdById], references: [id])

  @@unique([provider, externalId])
  @@index([loanId, createdAt(sort: Desc)])
  @@index([status])
}

// ─── Audit log (append-only) ─────────────────────────────────────────────────
//
// Records every privileged action: decide, disburse, payment, reversal,
// product create/edit, KYC override, etc. The schema is generic enough that
// any route can call AuditLogRepository.record() without coordination.

model AuditEvent {
  id                  String   @id @default(uuid())
  /// Coarse action label, e.g. "LOAN_DECIDE", "JOURNAL_REVERSE", "PRODUCT_CREATE".
  action              String
  /// User who performed the action.
  actorId             String
  /// Optional pointer to the affected row.
  targetType          String?
  targetId            String?
  /// Free-form context — reason, before/after snapshot, payload, etc.
  payload             Json?
  createdAt           DateTime @default(now())
  /// Set when the action was performed during a platform-impersonated
  /// session (vendor support staff logged in as `actorId` via
  /// `/platform/tenants/:slug/impersonate`). Two columns over a JSON
  /// blob because compliance queries them by id + email constantly.
  /// Null on every non-impersonated audit row (the common case).
  impersonatedById    String?
  impersonatedByEmail String?

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action])
  // Partial index: filter "audit rows from a support session." Skinny
  // because the typical row has impersonatedById = null.
  @@index([impersonatedById])
}

// ─── Background jobs (scheduler) ─────────────────────────────────────────────
//
// `ScheduledJob` is the registry — one row per named recurring job. `JobRun`
// is the audit trail of each execution.
//
// The scheduler runs in-process via node-cron. For horizontal scaling,
// swap to BullMQ + Redis later; the JobRun history schema stays.

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ScheduledJob {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  /// Standard cron expression, e.g. "0 1 * * *" = daily 01:00.
  cron        String
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  /// Computed by the scheduler each tick; informational only.
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs JobRun[]

  @@index([enabled])
}

model JobRun {
  id         String    @id @default(uuid())
  jobId      String
  status     JobStatus @default(PENDING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Free-form result payload (e.g. {posted, skipped}).
  result     Json?
  error      String?
  /// Whether the run was triggered by the schedule (false = manual).
  manual     Boolean   @default(false)

  job ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt(sort: Desc)])
  @@index([status])
}

// ─── Notifications (email / SMS dispatch) ────────────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Coarse event labels; the dispatcher maps each to a template at send time.
enum NotificationEvent {
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_DISBURSED
  PAYMENT_RECEIVED
  PAYMENT_DUE_SOON
  PAYMENT_OVERDUE
  PROMISE_TO_PAY
  WELCOME
  TEST
  /// Annual / renewable doc (e.g. car insurance) is within 30 days of expiry.
  ANNUAL_DOC_EXPIRING
  /// Annual doc has lapsed past its expiry — escalation channel.
  ANNUAL_DOC_EXPIRED
  /// Demand letter dispatched (First / Final / Attorney).
  DEMAND_LETTER_DISPATCHED
  /// Lease-to-own end-of-term notice (60 days before term ends).
  LEASE_END_OF_TERM
  /// Lease-to-own maintenance reminder (every 6 months).
  LEASE_MAINTENANCE_REMINDER
  /// Lease-to-own pull-out warning (3rd consecutive missed payment).
  LEASE_PULL_OUT_WARNING
  /// A co-maker has been asked to accept or decline being one.
  CO_MAKER_INVITED
  /// Someone asked to reset their password.
  PASSWORD_RESET
  /// A loan needs the recipient's approval (per-product approval chain).
  /// Fired on loan submit (step 1 approvers) and on each step advance
  /// (the next step's approvers). One row dispatched per recipient per
  /// channel; refId points to the loan, refType = "LoanApplication".
  LOAN_APPROVAL_PENDING
  /// Customer's Statement of Account has been generated and is ready to
  /// view in their portal. No PDF attachment — security; customer logs
  /// in to download. refType = "Customer", refId = customer id.
  STATEMENT_READY
  /// A delegation has been revoked — tell the delegate immediately so
  /// they know their proxy authority is gone. refType = "Delegation",
  /// refId = delegation id. Sent inline from the revoke endpoint.
  DELEGATION_REVOKED
  /// A user's role assignments changed (added or removed). Sent
  /// inline from the assign/unassign endpoints. refType = "User",
  /// refId = the affected user id (not the actor).
  USER_ROLE_CHANGED
}

model Notification {
  id          String              @id @default(uuid())
  event       NotificationEvent
  channel     NotificationChannel
  /// Email address or phone number, depending on channel.
  recipient   String
  /// Rendered subject/title.
  subject     String?
  /// Rendered body.
  body        String
  status      NotificationStatus  @default(QUEUED)
  /// Provider-side id if the provider returned one (e.g. SendGrid msg id).
  providerRef String?
  error       String?
  /// Optional pointer to the entity the notification refers to.
  refType     String?
  refId       String?
  /// Optional customer link for filtering.
  customerId  String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([event])
}

// ─── AML / PEP / sanctions screening ─────────────────────────────────────────

enum AmlStatus {
  /// Awaiting first screen.
  PENDING
  /// No matches.
  CLEAR
  /// Hit one or more watchlists.
  MATCH
  /// Officer needs to manually review borderline match.
  REVIEW
  /// Officer cleared the customer despite a match (overridden).
  OVERRIDDEN
}

model AmlScreening {
  id             String    @id @default(uuid())
  customerId     String
  status         AmlStatus @default(PENDING)
  /// Provider-side id (which provider ran the screen).
  provider       String    @default("MOCK")
  /// Provider's own reference for this screen.
  providerRef    String?
  /// Array of `{ list, name, score, details }` for matches found.
  matches        Json?
  notes          String?
  screenedAt     DateTime  @default(now())
  /// If OVERRIDDEN, who cleared it.
  overriddenById String?
  overriddenAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, screenedAt(sort: Desc)])
  @@index([status])
}

/// Mock watchlist row. Real providers replace this with a vendor API.
model AmlWatchlistEntry {
  id        String   @id @default(uuid())
  /// "PEP", "SANCTIONS", "ADVERSE_MEDIA", "INTERNAL".
  list      String
  fullName  String
  aliases   String[]
  /// Notes for the officer reviewing a match.
  reason    String?
  createdAt DateTime @default(now())

  @@index([fullName])
}

// ─── Co-makers / co-borrowers / guarantors ───────────────────────────────────
//
// One LoanApplication can have multiple co-makers. We capture the same
// underwriting data we'd want on the primary borrower (income, ID, etc.)
// plus their relationship to the customer.

enum CoMakerRole {
  CO_BORROWER // jointly liable
  GUARANTOR // backstop if primary defaults
  CO_MAKER // generic "second signer"
}

/// Where a co-maker stands on being one.
///
/// A co-maker is jointly liable, so their agreement is a decision they
/// make rather than a box the officer ticks. PENDING until they answer
/// the invite; disbursement is blocked while any of them is not
/// APPROVED (see LoanService.disburse).
enum CoMakerConsentStatus {
  PENDING
  APPROVED
  DECLINED
}

model CoMaker {
  id     String @id @default(uuid())
  loanId String

  /// The registered customer standing as co-maker.
  ///
  /// Co-makers used to be free text — a name and a phone number typed
  /// into a box. That made them invisible to everything the system
  /// knows how to do: no KYC on file, no credit history, no way to see
  /// that the same person was already guaranteeing four other loans,
  /// and no way to tell two spellings of one name apart. A co-maker is
  /// jointly liable for the debt, so they are underwritten too, and
  /// that means they have to be someone the system can actually look up.
  ///
  /// Nullable ONLY for rows created before this existed. New co-makers
  /// require it — enforced in the API schema rather than the column, so
  /// the historical rows stay readable instead of becoming invalid.
  customerId String?

  /// Snapshot of who they were when they were added.
  ///
  /// Denormalised from Customer on purpose, not laziness: the invite
  /// needs a number to send to at that moment, the consent record and
  /// the signed agreement have to name the person who actually agreed,
  /// and a customer editing their phone next year must not silently
  /// rewrite what a co-maker signed.
  fullName           String
  role               CoMakerRole       @default(CO_MAKER)
  relationship       String? // "Spouse" / "Parent" / "Sibling" / "Friend" / "Employer"
  phone              String
  email              String?
  address            String?
  governmentIdType   GovernmentIdType?
  governmentIdNumber String?
  /// Monthly income for capacity calculations.
  monthlyIncome      Decimal?          @db.Decimal(14, 2)
  /// URL of signed co-maker agreement, when available.
  signedAgreementUrl String?
  /// In-app signature PNG URL (canvas capture).
  signatureUrl       String?
  signedAt           DateTime?
  notes              String?

  // ── Consent ────────────────────────────────────────────────────────
  status          CoMakerConsentStatus @default(PENDING)
  respondedAt     DateTime?
  /// Their words, kept verbatim — a declined co-maker is a fact the
  /// officer has to act on, and "why" is the whole of it.
  declineReason   String?
  /// Opaque invite token. Stored rather than HMAC-derived so it can be
  /// revoked and rotated: a resend must invalidate the old link, which
  /// a stateless signature can't do.
  inviteToken     String?              @unique
  inviteSentAt    DateTime?
  inviteExpiresAt DateTime?
  /// When the consent link was FIRST opened. Null = never.
  ///
  /// The co-maker equivalent of presence, and the closest this system
  /// can get: they have no account, so there is no session to observe.
  /// What can be observed is whether the link they were sent was ever
  /// loaded.
  ///
  /// First open rather than most recent, because it answers the
  /// question an officer actually has. A co-maker who hasn't replied
  /// leaves two possibilities — they saw it and are hesitating, or it
  /// never reached them — and those call for completely different next
  /// moves (a phone call versus a resend to a corrected number).
  /// Overwriting on every view would answer "are they still looking",
  /// which nobody asks, and would destroy "did it arrive", which
  /// everybody does.
  ///
  /// Cleared by `issueInvite`: a resend is a new link, and carrying the
  /// old one's open over would report a delivery that hasn't happened.
  linkOpenedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan      LoanApplication   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  documents CoMakerDocument[]
  /// Restrict, not Cascade: deleting a customer who stands as co-maker
  /// on a live loan would quietly remove a party to that debt. The
  /// delete has to fail loudly so someone decides what happens to the
  /// loan first.
  customer  Customer?         @relation("CustomerCoMakerFor", fields: [customerId], references: [id], onDelete: Restrict)

  @@index([loanId])
  /// "What else is this person guaranteeing?" — the exposure question,
  /// which was unanswerable while co-makers were free text.
  @@index([customerId])
}

/// A file a co-maker attached when accepting.
///
/// Separate from KycSubmission, which is customer-scoped and carries a
/// verify/reject review cycle. These are attachments on a consent, not
/// submissions awaiting adjudication, and giving them a review status
/// would imply a workflow nobody runs.
model CoMakerDocument {
  id           String          @id @default(uuid())
  coMakerId    String
  documentType KycDocumentType
  documentUrl  String
  notes        String?
  uploadedAt   DateTime        @default(now())

  coMaker CoMaker @relation(fields: [coMakerId], references: [id], onDelete: Cascade)

  @@index([coMakerId])
}

// ─── Automated decisioning rules ─────────────────────────────────────────────
//
// Rules are evaluated in `priority` order (ascending; lowest first). The
// first rule whose conditions all match decides the loan's initial status.
// If no rule matches, the loan stays SUBMITTED for manual review.

enum RuleAction {
  AUTO_APPROVE
  AUTO_REJECT
  MANUAL_REVIEW
}

model DecisionRule {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  /// Lower = evaluated first. Conventionally: rejects use 10-90,
  /// approvals 100-900, manual-review fallbacks 1000+.
  priority    Int        @default(500)
  /// JSON array of `{ field, op, value }` conditions; ALL must match.
  /// See @loan/decisioning for the schema.
  conditions  Json
  action      RuleAction
  /// Stored on the loan's `decisionReason` when this rule fires.
  reason      String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([priority, active])
}

// ─── Pre-assessment (pre-application eligibility check) ──────────────────────
//
// Runs the decisioning rules WITHOUT creating a loan, and keeps the result.
// Two callers, one table:
//
//   • PORTAL  — a borrower checking their own eligibility before applying.
//               `customerId` is always set, so score / AML / KYC come off
//               their record and the verdict is as good as a dry-run's.
//   • OFFICER — staff assessing a walk-in prospect who has no Customer row.
//               Only the hand-entered figures are known, so the context
//               carries nulls for score / tier / AML and `kycComplete:
//               false`. Indicative, not a decision.
//
// Deliberately NOT the same thing as POST /loans/dry-run: that previews one
// in-flight application inside the officer's wizard and stores nothing. A
// pre-assessment outlives the session — it is what the applicant was told,
// and `loanId` links it to the application it became.

enum PreAssessmentSource {
  /// Borrower ran it on themselves from the portal.
  PORTAL
  /// Staff ran it, typically for a prospect with no Customer row yet.
  OFFICER
}

/// The rule engine's RuleAction flattened to the three outcomes the UI
/// shows: AUTO_APPROVE → APPROVE, AUTO_REJECT → REJECT, everything else
/// (including "no rule matched") → REVIEW.
enum PreAssessmentVerdict {
  APPROVE
  REVIEW
  REJECT
}

model PreAssessment {
  id     String              @id @default(uuid())
  /// Human-readable: "PA-2026-000123". Quoted to the applicant and used in
  /// the UI in place of the UUID. Same convention as Customer.number /
  /// LoanApplication.number, so `idOrNumberWhere` resolves it.
  number String              @unique
  source PreAssessmentSource

  // ── Subject ─────────────────────────────────────────────────────────
  // Exactly one side is meaningful: an existing customer, or a hand-entered
  // prospect. Both are nullable because a PORTAL row always has the former
  // and never the latter, and an OFFICER walk-in row has the reverse.
  customerId    String?
  prospectName  String?
  prospectPhone String?
  prospectEmail String?

  // ── Inputs (what was asked for) ─────────────────────────────────────
  productCode        String
  principal          Decimal @db.Decimal(14, 2)
  termMonths         Int
  /// Annual rate as decimal: 0.18 = 18%/year. Matches LoanApplication.
  annualInterestRate Decimal @db.Decimal(6, 4)
  /// Read off the Customer row when there is one, declared otherwise.
  monthlyIncome      Decimal @db.Decimal(14, 2)
  applicantAge       Int

  // ── Outcome ─────────────────────────────────────────────────────────
  verdict         PreAssessmentVerdict
  reason          String
  /// The rule that fired. Not a foreign key: rules get edited and deleted,
  /// and the verdict still has to be explainable afterwards, so the name is
  /// snapshotted alongside the id.
  matchedRuleId   String?
  matchedRuleName String?
  /// Full DecisioningContext as evaluated. The rules can change tomorrow;
  /// this is what they saw today.
  context         Json
  /// AML / KYC pre-flight gates. Null on prospect rows — no customer, no
  /// gates to check.
  gates           Json?
  /// Statistical anomaly flags, same shape as the dry-run's.
  anomalies       Json?

  // ── Conversion ──────────────────────────────────────────────────────
  /// Set when this assessment turned into a real application.
  loanId      String?   @unique
  convertedAt DateTime?

  createdAt   DateTime @default(now())
  /// Who ran it — the borrower's own login for PORTAL rows, the officer for
  /// OFFICER rows. Not a foreign key, same reasoning as Customer.erasedById:
  /// staff leave, and the assessment stays on file for years after.
  createdById String?

  // SetNull on both sides. An erased customer or a deleted loan shouldn't
  // take the assessment history with it — the figures and the verdict are
  // still a record of what we told someone.
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  loan     LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([verdict])
}

// ─── RBAC: permissions + dynamic roles ───────────────────────────────────────
//
// Layered on top of the existing `UserRole` enum. The enum stays for display
// + JWT compatibility (it's the user's "primary role"); fine-grained access
// checks go through `requirePermission`, which evaluates the union of
// permissions across the user's assigned `Role` rows.
//
// Seeded canonical roles (ADMIN / LOAN_OFFICER / ACCOUNTANT / CUSTOMER) are
// flagged `system: true` and cannot be deleted. Their permission sets can
// still be edited if the lender wants tighter or looser defaults.

model Permission {
  id          String           @id @default(uuid())
  /// Stable identifier referenced by code (e.g. "loans.approve").
  key         String           @unique
  label       String
  description String?
  /// UI grouping ("Loans", "Accounting", etc.)
  category    String
  /// System permissions can't be deleted (code references them).
  system      Boolean          @default(true)
  /// Lifecycle gate:
  ///   - ACTIVE     — fully effective (the historical default)
  ///   - DRAFT      — present in the catalog but the resolver does not
  ///                  grant it; lets admins wire role membership before
  ///                  flipping the perm on
  ///   - DEPRECATED — still effective (so we don't break in-flight
  ///                  flows), but flagged in the UI so admins can plan
  ///                  removal from role permission sets
  status      PermissionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())

  roles RolePermission[]

  @@index([category])
  @@index([status])
}

enum PermissionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

model Role {
  id          String   @id @default(uuid())
  /// Stable identifier; uppercase for system roles, free-form for custom.
  key         String   @unique
  name        String
  description String?
  /// System roles can't be deleted.
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRoleAssignment[]

  /// Composition / inheritance. A role can declare zero or more
  /// "parent" roles whose permissions are unioned into its effective
  /// set at resolve time. Cycles are rejected by the write path; the
  /// resolver still cycle-guards with a visited set as belt-and-braces.
  parents  RoleInheritance[] @relation("ChildToParent")
  children RoleInheritance[] @relation("ParentToChild")
}

/// Join table for the Role ⇆ Role self-many-to-many inheritance graph.
/// `child` inherits from `parent` — picking up parent's permission set.
model RoleInheritance {
  childId  String
  parentId String

  child  Role @relation("ChildToParent", fields: [childId], references: [id], onDelete: Cascade)
  parent Role @relation("ParentToChild", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([childId, parentId])
  // Reverse-lookup index for "who inherits from me?" queries (used
  // by the cycle-detection check at write time).
  @@index([parentId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  userId      String
  roleId      String
  grantedAt   DateTime  @default(now())
  grantedById String?
  // Optional expiry. NULL = perpetual; otherwise the assignment stops
  // granting permissions once `expiresAt < now()`. The permission
  // resolver filters on this; the row itself is left in place for
  // auditability. A future cron may sweep expired rows but isn't
  // required — read-time filtering is sufficient for correctness.
  expiresAt   DateTime?

  user User @relation("UserRoleAssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  // Index on expiresAt so any "expiring soon" query doesn't full-scan.
  @@index([expiresAt])
}

// ─── Delegation (proxy authority with date range + scoped permissions) ───────
//
// A user (delegator) can grant a subset of their permissions to another user
// (delegate) for a date range. The delegate's own account performs the
// action — their userId stays on the audit log — but the active delegation
// expands the permission set requirePermission sees, so they pass checks
// they normally wouldn't.
//
// For signatures specifically, the signing endpoint accepts the delegation
// id so the loan agreement PDF can be honest about who signed under whose
// authority.

model Delegation {
  id            String    @id @default(uuid())
  delegatorId   String
  delegateId    String
  /// Permission keys included. Empty = all of delegator's role permissions.
  permissions   String[]
  startsAt      DateTime
  endsAt        DateTime
  /// Free-form reason, e.g. "Leave Mar 1-15", "Manager off-site Thursday".
  note          String?
  /// Revoked early? null = still active (subject to endsAt).
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  delegator User @relation("Delegator", fields: [delegatorId], references: [id])
  delegate  User @relation("Delegate", fields: [delegateId], references: [id])

  signedLoans   LoanApplication[] @relation("OfficerSignedUnderDelegation")
  loanApprovals LoanApproval[]    @relation("LoanApprovalDelegation")

  @@index([delegateId, startsAt, endsAt])
  @@index([delegatorId])
  @@index([revokedAt])
}

// ─── In-app messaging (officer ↔ borrower) ──────────────────────────────────
//
// Lightweight thread per loan. Either party (the assigned officer or the
// borrower's portal account) can post; the other sees the message in the
// loan detail page. We track read-state cursors on the message rather
// than per-thread so individual notifications can deep-link.

enum LoanMessageAuthor {
  OFFICER
  BORROWER
}

model LoanMessage {
  id         String            @id @default(uuid())
  loanId     String
  /// User id of whoever wrote it. The author's role at send-time is
  /// captured separately so a role change later doesn't rewrite history.
  authorId   String
  authorRole LoanMessageAuthor
  body       String            @db.Text
  /// Set when the recipient has acknowledged the message.
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  loan LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
  @@index([readAt])
}

// ─── ECL provisioning (IFRS 9 / PFRS 9) ─────────────────────────────────────
//
// The expected-credit-loss model has three stages keyed off DPD and risk
// signals. ECL = PD × LGD × EAD, where:
//   PD  — probability of default (12-month for Stage 1; lifetime for 2/3)
//   LGD — loss given default (per-product configurable)
//   EAD — exposure at default (= outstanding principal here; simple approx)
//
// The periodic ECL job:
//   1. For every active loan, recompute eclStage from DPD:
//        0–29 DPD  → STAGE_1 (or keep current if SICR-flagged)
//        30–89 DPD → STAGE_2
//        ≥90 DPD   → STAGE_3
//   2. Compute provision per the formula above using the matching PD.
//   3. Posts a single GL movement for the period: DR Impairment Expense,
//      CR Allowance for Loan Losses (a contra-asset).
//   4. Saves an EclRun summary row so the auditor sees a history.

enum EclStage {
  STAGE_1
  STAGE_2
  STAGE_3
}

model EclRun {
  id          String   @id @default(uuid())
  /// First day of the period this run computes for (typically month start).
  periodStart DateTime
  periodEnd   DateTime
  /// As-of date the computation ran against — usually periodEnd.
  asOf        DateTime @default(now())

  /// Aggregate snapshot — the per-loan provisions live on LoanApplication
  /// (eclProvision/eclStage); EclRun is the journal.
  totalEad    Decimal @db.Decimal(18, 2)
  totalEcl    Decimal @db.Decimal(18, 2)
  stage1Count Int
  stage2Count Int
  stage3Count Int
  stage1Ecl   Decimal @db.Decimal(18, 2)
  stage2Ecl   Decimal @db.Decimal(18, 2)
  stage3Ecl   Decimal @db.Decimal(18, 2)

  /// Journal entry that booked the impairment movement, if any.
  journalEntryId String?
  computedById   String?
  notes          String?

  @@index([periodEnd])
}

// ─── Bank reconciliation ────────────────────────────────────────────────────
//
// Bank statement is an imported CSV (one row per transaction); each row
// becomes a BankStatementLine. We auto-match against existing LoanPayment
// (incoming) or LoanApplication.disbursedAt entries (outgoing) by amount
// + date proximity + optional reference; unmatched rows surface in the
// reconciliation UI for manual reconciliation.

enum BankStatementStatus {
  IMPORTED
  RECONCILED
  ARCHIVED
}

model BankStatement {
  id             String              @id @default(uuid())
  /// e.g. "BPI-Current-202605", picked by the user at import time.
  label          String
  /// The user-named bank account this statement covers. Could promote to a
  /// FK to a BankAccount table later — single source of truth for now.
  bankAccount    String
  periodStart    DateTime
  periodEnd      DateTime
  /// Reported opening / closing balance from the bank.
  openingBalance Decimal             @db.Decimal(18, 2)
  closingBalance Decimal             @db.Decimal(18, 2)
  importedById   String?
  importedAt     DateTime            @default(now())
  status         BankStatementStatus @default(IMPORTED)

  lines BankStatementLine[]

  @@index([periodStart, periodEnd])
  @@index([status])
}

model BankStatementLine {
  id             String    @id @default(uuid())
  statementId    String
  txnDate        DateTime
  description    String
  /// Positive = credit (money in), negative = debit (money out).
  amount         Decimal   @db.Decimal(18, 2)
  reference      String?
  /// Running balance per the bank, if present in the CSV.
  runningBalance Decimal?  @db.Decimal(18, 2)
  /// Set when reconciled. Match type tells us *what* it was matched to —
  /// a LoanPayment for incoming, a Loan disbursement for outgoing, or
  /// MANUAL for everything else (bank fees, owner draws, etc).
  matchedType    String?
  matchedRefId   String?
  matchedAt      DateTime?
  matchedById    String?
  /// Free-form note typed by the reconciler — useful for MANUAL matches.
  matchNote      String?

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([txnDate])
  @@index([matchedAt])
}

// ─── Refresh tokens ─────────────────────────────────────────────────────────
//
// JWT access tokens are short-lived (24h). To keep users signed in beyond
// that without forcing daily re-login, /auth/login also issues a long-lived
// random refresh token. The web client stores both; on a 401 it calls
// /auth/refresh and gets a fresh access token in exchange.
//
// We store only the SHA-256 of the refresh token so a DB leak doesn't yield
// usable tokens. On every refresh we rotate — the old token is marked
// revoked and replaced by a new one. If a revoked token is ever presented
// (= token theft), we revoke the entire family for that user.

/// A single-use password reset grant.
///
/// Same shape as RefreshToken and for the same reason: only the
/// SHA-256 is stored, so a database compromise yields no usable reset
/// links. Single-use is enforced by `usedAt` rather than deletion —
/// keeping the spent row lets a second click on the same link say
/// "already used" instead of the indistinguishable "invalid", and
/// leaves a trail that a reset happened.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("UserPasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  /// SHA-256 of the opaque token returned to the client. Never the raw value.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// When rotated, points at the replacement so we can detect re-use
  /// (presenting a revoked token whose successor is still active).
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Cooperative modules ────────────────────────────────────────────────────
//
// Companion module set to the loan operations: members (= Customer rows)
// contribute monthly to several funds and may also save voluntarily. We
// also track the coop's own cash flow — funds in, withdrawals out, expenses,
// other income, and external capital injections ("Big Brother").
//
// Every monetary movement here is auto-posted to the GL. See the
// `cooperative*Entry` helpers in libs/accounting/src/posting.ts for the
// exact debits/credits per type.

/**
 * Free-form "bucket" identifying which fund a movement touches. Used by
 * FundTransaction, FundWithdrawal, Expense (sourceOfFunds) and OtherIncome
 * (sourceTo). Kept as a string rather than an enum so admins can add new
 * buckets without a migration; the canonical set is documented in the UI.
 * CAPITAL_BUILD_UP | MORTUARY_FUND | EMERGENCY_FUND |
 * SAVINGS | BIG_BROTHER | GENERAL | OTHER
 */

model Contribution {
  id             String   @id @default(uuid())
  customerId     String
  /// Equity contribution — each member's stake in the coop.
  capitalBuildUp Decimal  @default(0) @db.Decimal(14, 2)
  /// Death-benefit pool.
  mortuaryFund   Decimal  @default(0) @db.Decimal(14, 2)
  /// Short-term emergency assistance pool.
  emergencyFund  Decimal  @default(0) @db.Decimal(14, 2)
  notes          String?
  contributedAt  DateTime @default(now())
  recordedById   String?
  /// Journal entry that booked this contribution. Null = posting deferred.
  journalEntryId String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, contributedAt])
  @@index([contributedAt])
}

enum SavingsTxnKind {
  DEPOSIT
  WITHDRAWAL
}

model SavingsTransaction {
  id             String         @id @default(uuid())
  customerId     String
  kind           SavingsTxnKind @default(DEPOSIT)
  amount         Decimal        @db.Decimal(14, 2)
  notes          String?
  txnDate        DateTime       @default(now())
  recordedById   String?
  journalEntryId String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, txnDate])
  @@index([txnDate])
}

/**
 * Generic fund inflow — anything that increases a fund balance and doesn't
 * fit Contribution (member dues) or Savings (voluntary deposits). Examples:
 * interest earned by the mortuary fund, transfers in from other accounts.
 * `customerId` is optional because not all inflows are member-attributable.
 */
model FundTransaction {
  id             String   @id @default(uuid())
  customerId     String?
  transactionRef String?
  sourceOfFunds  String
  amount         Decimal  @db.Decimal(14, 2)
  txnDate        DateTime @default(now())
  /// Who recorded the row — UI shows their name as "Author".
  authorId       String?
  notes          String?
  journalEntryId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sourceOfFunds, txnDate])
  @@index([customerId])
}

model FundWithdrawal {
  id             String   @id @default(uuid())
  customerId     String?
  sourceOfFunds  String
  amount         Decimal  @db.Decimal(14, 2)
  notes          String?
  txnDate        DateTime @default(now())
  authorId       String?
  journalEntryId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sourceOfFunds, txnDate])
  @@index([customerId])
}

model Expense {
  id             String   @id @default(uuid())
  type           String
  amount         Decimal  @db.Decimal(14, 2)
  sourceOfFunds  String
  txnDate        DateTime @default(now())
  /// Repeating expenses (rent, utilities). UI surfaces these so they can
  /// be reviewed periodically; doesn't auto-create future instances —
  /// that's a separate scheduling concern.
  isRecurring    Boolean  @default(false)
  /// Receipt / invoice URLs (uploaded via /uploads-api).
  attachments    String[]
  notes          String?
  recordedById   String?
  journalEntryId String?

  @@index([type, txnDate])
  @@index([txnDate])
}

model OtherIncome {
  id             String   @id @default(uuid())
  type           String
  amount         Decimal  @db.Decimal(14, 2)
  /// Which fund this income credits — same string buckets as Funds.
  sourceTo       String
  txnDate        DateTime @default(now())
  attachments    String[]
  notes          String?
  recordedById   String?
  journalEntryId String?

  @@index([type, txnDate])
  @@index([txnDate])
}

/**
 * "Big Brother" = external capital provider (NGO, parent coop, donor).
 * They inject capital for a fixed period. Modelled as a liability so the
 * balance sheet reflects the eventual repayment obligation; equity-like
 * treatment can be applied at period-end via a manual adjustment if the
 * arrangement is a grant rather than a return-of-capital deal.
 */
model BigBrotherAccount {
  id             String   @id @default(uuid())
  /// Lender / sponsor name.
  name           String
  /// Their reference / account identifier.
  account        String
  capital        Decimal  @db.Decimal(18, 2)
  periodFrom     DateTime
  periodTo       DateTime
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  recordedById   String?
  journalEntryId String?

  @@index([active])
  @@index([periodFrom, periodTo])
}

// ─── Penalty waivers ─────────────────────────────────────────────────────────
//
// Officers may waive part or all of accrued late-fees as part of a settlement
// negotiation. We snapshot the original accrued penalty at waive time, the
// negotiated amount left in place, and post a reversing journal entry to keep
// the GL consistent (DR Fee Income / CR Loans Receivable for the waived
// portion). The originalPenalty / negotiatedPenalty pair is what the UI shows
// on subsequent payment-posting screens.
model PenaltyWaiver {
  id                String   @id @default(uuid())
  loanId            String
  /// Total late-fee accrued on this loan at the moment of waive (sum of
  /// all LATE_FEE_ACCRUAL postings minus any prior waivers).
  originalPenalty   Decimal  @db.Decimal(14, 2)
  /// Amount of `originalPenalty` being waived now. Always > 0.
  waivedAmount      Decimal  @db.Decimal(14, 2)
  /// Whatever stays on the books after the waive (`original - waived`).
  /// Stored explicitly so the UI doesn't have to recompute.
  negotiatedPenalty Decimal  @db.Decimal(14, 2)
  reason            String   @db.VarChar(500)
  /// FK to the GL reversal posted at waive time.
  journalEntryId    String?
  waivedById        String
  waivedAt          DateTime @default(now())

  loan         LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  waivedBy     User            @relation("PenaltyWaivedBy", fields: [waivedById], references: [id])
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([loanId, waivedAt])
}

// ─── Annual / renewable documents ────────────────────────────────────────────
//
// Some loan types require docs that must be renewed annually — car insurance
// for auto loans, real-property tax for mortgages, fire insurance, OR/CR
// updates. Unlike one-shot KYC documents these expire and the borrower must
// re-submit before the next due date.
//
// A scheduled job scans for rows with expiresAt within 30 days and enqueues
// notifications (ANNUAL_DOC_EXPIRING or ANNUAL_DOC_EXPIRED depending on the
// window). `lastReminderAt` guards against re-sending in the same window.

enum AnnualDocumentType {
  /// Auto-loan comprehensive or TPL insurance.
  CAR_INSURANCE
  /// Land Transportation Office certificate of registration / official receipt.
  OR_CR
  /// Real property tax for mortgage collateral.
  RPT
  /// Fire insurance on mortgage collateral.
  FIRE_INSURANCE
  /// Anything else the underwriter wants tracked annually.
  OTHER
}

enum AnnualDocumentStatus {
  /// Submitted and current — `expiresAt` is far enough in the future.
  VALID
  /// Within 30 days of expiry. Auto-computed in repository views.
  EXPIRING_SOON
  /// Past `expiresAt`. Borrower must re-submit.
  EXPIRED
}

// ─── Demand letters ──────────────────────────────────────────────────────────
//
// Formal escalation when a loan is materially overdue. Policy specifies
// First (60+ days) and Final (90+ days) letters from the company itself, plus
// Attorney variants when escalated to outside counsel. The batch flow:
//
//   1. Officer opens the demand-letter screen, filters by stage.
//   2. The repository identifies candidate loans (overdue > threshold,
//      no active waiver, no existing letter at this stage in last 30d).
//   3. Officer tick-boxes the rows, clicks Generate -> DRAFTED rows created.
//   4. Officer reviews each draft, then Dispatch -> notification fires.
//   5. If the borrower pays before dispatch (or the case is restructured),
//      the row is set to WAIVED with a reason.
//
// Amounts are snapshotted at draft time so the letter text matches the
// borrower's then-current obligation, even if they later pay something.

enum DemandLetterStage {
  /// First reminder from Company — typically after 60 days overdue.
  FIRST
  /// Final reminder from Company — typically after 90 days overdue.
  FINAL
  /// First attorney letter (legal escalation).
  ATTORNEY_FIRST
  /// Final attorney letter (last chance before legal action).
  ATTORNEY_FINAL
}

enum DemandLetterStatus {
  /// Created but not yet sent. Editable.
  DRAFTED
  /// Reviewed + signed off by the appropriate signatory (Operations
  /// Manager for company variants; Lawyer for attorney variants) per
  /// the escalation matrix. Locked from edits.
  APPROVED
  /// Sent via email/SMS/post. Terminal-but-open.
  DISPATCHED
  /// Borrower responded (paid / arrangement). Closes the case.
  RESPONDED
  /// Officer waived this letter (special handling, ongoing arrangement, etc.).
  WAIVED
}

model DemandLetter {
  id     String             @id @default(uuid())
  loanId String
  stage  DemandLetterStage
  status DemandLetterStatus @default(DRAFTED)

  /// Snapshot of the financials at draft time so the letter remains
  /// faithful even if the borrower part-pays before dispatch.
  principalOwed Decimal @db.Decimal(14, 2)
  interestOwed  Decimal @db.Decimal(14, 2)
  penaltiesOwed Decimal @db.Decimal(14, 2)
  totalOwed     Decimal @db.Decimal(14, 2)
  daysOverdue   Int

  /// Date the borrower must pay by per the letter.
  paymentDeadline DateTime

  /// Rendered letter body — what the dispatcher sends. Captured at draft
  /// time so re-render-on-dispatch can't drift from what was approved.
  body String @db.Text

  /// Created at draft time.
  draftedAt   DateTime @default(now())
  draftedById String

  /// Approval gate. Set when status -> APPROVED.
  approvedAt   DateTime?
  approvedById String?
  approvalNote String?   @db.VarChar(500)

  /// Set when status -> DISPATCHED.
  dispatchedAt    DateTime?
  dispatchedById  String?
  /// Channel used (free-form to allow future channels — EMAIL/SMS/COURIER/POST).
  dispatchChannel String?
  dispatchRef     String?

  /// Set when status -> WAIVED or RESPONDED.
  closedAt     DateTime?
  closedById   String?
  closedReason String?   @db.VarChar(500)

  loan         LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  draftedBy    User            @relation("DemandLetterDrafted", fields: [draftedById], references: [id])
  approvedBy   User?           @relation("DemandLetterApproved", fields: [approvedById], references: [id])
  dispatchedBy User?           @relation("DemandLetterDispatched", fields: [dispatchedById], references: [id])
  closedBy     User?           @relation("DemandLetterWaived", fields: [closedById], references: [id])

  @@index([loanId, status])
  @@index([stage, status])
  @@index([draftedAt(sort: Desc)])
}

model AnnualDocument {
  id             String               @id @default(uuid())
  loanId         String
  type           AnnualDocumentType
  /// Free-form display label, e.g. "Comprehensive insurance 2026-2027".
  name           String               @db.VarChar(200)
  documentUrl    String?
  effectiveFrom  DateTime
  expiresAt      DateTime
  status         AnnualDocumentStatus @default(VALID)
  notes          String?
  submittedAt    DateTime             @default(now())
  submittedById  String
  /// Last reminder sent for this row — tracked so the daily job doesn't
  /// re-spam the borrower every tick within the 30-day window.
  lastReminderAt DateTime?
  reminderCount  Int                  @default(0)

  loan        LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  submittedBy User            @relation("AnnualDocSubmittedBy", fields: [submittedById], references: [id])

  @@index([loanId, expiresAt])
  @@index([expiresAt])
  @@index([status])
}

// ─── Repossession ────────────────────────────────────────────────────────────
//
// Workflow state machine when an auto-loan defaults beyond recovery via
// demand letter. One active case per loan (enforced by unique constraint
// on loanId). The case advances through approvals before an agent can be
// dispatched. After recovery, the vehicle is auctioned and any deficiency
// is booked as bad debt.
//
//   IDENTIFIED → BM_APPROVED → CREDIT_HEAD_APPROVED → LEGAL_APPROVED
//     → AGENT_ASSIGNED → RECOVERED → AUCTIONED → CLOSED
//                                            ↘ CANCELLED (mid-flow exit)

enum RepossessionStatus {
  /// Collection team flagged the loan as repossession candidate.
  IDENTIFIED
  /// Branch Manager approval.
  BM_APPROVED
  /// Credit Head approval.
  CREDIT_HEAD_APPROVED
  /// Legal Department approval — agent can now be dispatched.
  LEGAL_APPROVED
  /// Agent assigned to recover the vehicle.
  AGENT_ASSIGNED
  /// Vehicle is in our possession; inventory + photos captured.
  RECOVERED
  /// Vehicle sold; proceeds applied. Any deficiency posted to bad debt.
  AUCTIONED
  /// Terminal — either fully settled or deficiency booked.
  CLOSED
  /// Cancelled mid-flow (e.g. borrower paid or restructured).
  CANCELLED
}

model RepossessionCase {
  id     String             @id @default(uuid())
  /// One active case per loan. Cancelling closes the case so a future one
  /// can be opened if the borrower defaults again.
  loanId String             @unique
  status RepossessionStatus @default(IDENTIFIED)
  reason String             @db.VarChar(500)

  identifiedAt   DateTime @default(now())
  identifiedById String

  // ── Approval chain (Branch Manager → Credit Head → Legal) ─────────────
  bmApprovedAt           DateTime?
  bmApprovedById         String?
  bmApprovalNote         String?
  creditHeadApprovedAt   DateTime?
  creditHeadApprovedById String?
  creditHeadApprovalNote String?
  legalApprovedAt        DateTime?
  legalApprovedById      String?
  legalApprovalNote      String?

  // ── Agent assignment ──────────────────────────────────────────────────
  agentName         String?
  agentContact      String?
  agentAssignedAt   DateTime?
  agentAssignedById String?

  // ── Vehicle recovery (Inventory and Storage) ──────────────────────────
  recoveredAt      DateTime?
  recoveredById    String?
  vehicleCondition String?   @db.VarChar(500)
  vehicleMileage   Int?
  /// Comma-separated photo URLs. Simple list; promote to a separate table
  /// if we need per-photo metadata later.
  vehiclePhotos    String?
  storageLocation  String?

  // ── Auction (Disposal of Vehicle) ─────────────────────────────────────
  auctionedAt           DateTime?
  auctionedById         String?
  /// "PUBLIC" / "DEALER" / etc.
  auctionMethod         String?
  auctionProceeds       Decimal?  @db.Decimal(14, 2)
  /// Outstanding loan balance at the moment of recovery — snapshot used
  /// to compute the deficiency.
  outstandingAtRecovery Decimal?  @db.Decimal(14, 2)
  /// max(0, outstandingAtRecovery - auctionProceeds). Booked as bad debt.
  deficiency            Decimal?  @db.Decimal(14, 2)
  /// FK to the auction settlement JE (REPOSSESSION_AUCTION source).
  journalEntryId        String?

  // ── Cancellation ──────────────────────────────────────────────────────
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?   @db.VarChar(500)

  loan                 LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  identifiedBy         User            @relation("RepoIdentified", fields: [identifiedById], references: [id])
  bmApprovedBy         User?           @relation("RepoBmApproved", fields: [bmApprovedById], references: [id])
  creditHeadApprovedBy User?           @relation("RepoCreditApproved", fields: [creditHeadApprovedById], references: [id])
  legalApprovedBy      User?           @relation("RepoLegalApproved", fields: [legalApprovedById], references: [id])
  agentAssignedBy      User?           @relation("RepoAgentAssigned", fields: [agentAssignedById], references: [id])
  recoveredBy          User?           @relation("RepoRecovered", fields: [recoveredById], references: [id])
  auctionedBy          User?           @relation("RepoAuctioned", fields: [auctionedById], references: [id])
  cancelledBy          User?           @relation("RepoCancelled", fields: [cancelledById], references: [id])
  journalEntry         JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([status])
  @@index([identifiedAt(sort: Desc)])
}

// ─── DORSI compliance ────────────────────────────────────────────────────────
//
// DORSI = Directors / Officers / Stockholders / Related Interests. Loans to
// these parties are tightly capped:
//
//   Aggregate: 15% of Company Total Equity (across ALL DORSI loans)
//   Individual: 30% of that aggregate cap (per single DORSI borrower)
//
// Both caps live in `SystemConfig.companyTotalEquity`. The dashboard tracks
// utilization in real time and the loan-apply gate refuses to disburse
// past the cap without a recorded board approval.
//
// The DORSI tag is per-customer, captured at customer onboarding (or set
// later by admin). Loans inherit the tag implicitly via customerId.

enum DorsiCategory {
  /// Member of the Board of Directors.
  DIRECTOR
  /// Senior officer of the company.
  OFFICER
  /// Stockholder owning at least 20% of voting shares.
  STOCKHOLDER
  /// Spouse, parent, child, business partner, etc. of the above.
  RELATED_INTEREST
}

model DorsiRecord {
  id               String        @id @default(uuid())
  /// One DORSI record per customer.
  customerId       String        @unique
  category         DorsiCategory
  /// Free-form basis for the tag — required for the audit trail.
  basis            String        @db.VarChar(500)
  /// False once the relationship ends (resigned, sold shares, etc.).
  active           Boolean       @default(true)
  /// requires re-attestation on account renewal — admins
  /// stamp this when they confirm the record is still accurate.
  lastReviewedAt   DateTime?
  lastReviewedById String?

  taggedAt   DateTime @default(now())
  taggedById String

  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?   @db.VarChar(500)

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  taggedBy      User     @relation("DorsiTaggedBy", fields: [taggedById], references: [id])
  reviewedBy    User?    @relation("DorsiReviewedBy", fields: [lastReviewedById], references: [id])
  deactivatedBy User?    @relation("DorsiDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([category, active])
  @@index([active])
}

/// Board approval recorded for a single loan that would otherwise breach
/// the DORSI cap. The loan's apply/decide flow checks for the presence
/// of this row when the cap math says board review is required.
model DorsiBoardApproval {
  id                       String   @id @default(uuid())
  loanId                   String   @unique
  /// Snapshot of utilization (0..1) at approval time — both numbers.
  aggregateUtilizationPct  Float
  individualUtilizationPct Float
  meetingDate              DateTime
  /// Board meeting minutes reference / link.
  minutesRef               String?  @db.VarChar(200)
  note                     String?  @db.VarChar(500)
  approvedAt               DateTime @default(now())
  /// The admin user who attested that the board approved this loan.
  approvedById             String

  loan       LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  approvedBy User            @relation("DorsiBoardApprovedBy", fields: [approvedById], references: [id])
}

/// Singleton config row (id = "singleton"). Holds runtime-tunable values
/// that don't belong in env vars (because finance staff manage them).
/// Currently just the Company Total Equity used as the base for DORSI
/// cap calculations; future settings go here too.
model SystemConfig {
  id                 String  @id @default("singleton")
  companyTotalEquity Decimal @default(0) @db.Decimal(20, 2)

  /// Org-wide ceiling on session idle. When the browser sees no user
  /// activity for this many seconds, the shell pops the warning dialog.
  /// Per-user override can be stricter but never longer. Default tracks
  /// the financial-app norm of "short fuse" — change in /settings.
  idleTimeoutSeconds Int @default(60)
  /// Countdown shown inside the warning dialog before forced logout.
  /// The user can dismiss (Stay signed in) to reset both timers.
  idleWarningSeconds Int @default(60)

  // ── Branding ───────────────────────────────────────────────────────
  // Surfaced in the sidebar, document.title, generated PDFs, and the
  // body of operator-facing notifications. Admin-editable from /settings.
  /// Display name. Defaults to the env-var convention so existing
  /// installs keep their identity until an admin sets a custom value.
  companyName    String  @default("SmartLoan")
  /// `/uploads/branding/…` path — null = no custom logo, shell falls
  /// back to the built-in Wallet icon glyph.
  companyLogoUrl String?
  /// Short marketing line shown beneath the brand glyph in the sidebar.
  companyTagline String?
  /// Postal address used in PDF letterheads.
  companyAddress String?
  /// Contact phone for letterheads / demand letters.
  companyPhone   String?
  /// Contact email for letterheads / demand letters.
  companyEmail   String?
  /// Marketing site URL for letterhead footer.
  companyWebsite String?

  // ── Retention policy ───────────────────────────────────────────────
  // Drives the nightly `data-retention-purge` job. Each value is in
  // DAYS; 0 means "never purge". Defaults track AMLA §9 / BSP 706
  // (5y for transactional + audit records) for the audit knob and
  // operational-only for the others.
  /// Audit-event retention. Default 1825 days (5 years — AMLA floor).
  /// Lowering below 1825 surfaces a warning in the settings UI.
  auditRetentionDays        Int @default(1825)
  /// Notification retention. Default 365 days; ops-history only.
  notificationRetentionDays Int @default(365)
  /// JobRun retention. Default 90 days; pure telemetry.
  jobRunRetentionDays       Int @default(90)

  // ── Per-tenant notification providers ──────────────────────────────
  // Each tenant can bring its own Twilio + SendGrid credentials. When
  // any field below is null, the channel falls back to the platform's
  // shared provider. Stored as plaintext columns; tenant DB isolation
  // is the boundary. Swap to AES-256-GCM at-rest when a customer's
  // security review demands it (the column shape doesn't change).
  twilioAccountSid  String?
  twilioAuthToken   String?
  /// E.164 number or alphanumeric sender id ("ACME-COOP")
  twilioFromNumber  String?
  sendgridApiKey    String?
  /// Must be a verified sender on the SendGrid account
  sendgridFromEmail String?
  sendgridFromName  String?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SystemConfigUpdatedBy", fields: [updatedById], references: [id])
}

// ─── Lease-to-Own agreement ──────────────────────────────────────────────────
//
// A hybrid auto-loan where the borrower leases the vehicle and pays a
// residual at the end to take title. The standard LoanSchedule covers the
// monthly lease payments; the residual is captured here so the buyout flow
// can post a discrete payment + transfer title (vehicleId.status flips to
// OWNED). For non-employees only, 3 consecutive missed payments triggers
// vehicle pull-out.
//
// One row per loan (1:1) when the loan's product has isLease=true. Created
// at disburse-time by LoanRepository.disburse().

enum LeaseStatus {
  /// In good standing — monthly payments being made.
  ACTIVE
  /// 3+ consecutive misses (non-employees) — agent pulls the vehicle.
  PULLED_OUT
  /// Borrower paid residual and took title.
  BUYOUT_COMPLETED
  /// Borrower returned the vehicle at end-of-term instead of buying.
  RETURNED
  /// Extended past original lease term per agreement.
  EXTENDED
}

enum LeaseTitleHolder {
  /// Company (default during the lease).
  COMPANY
  /// Borrower (post-buyout).
  CUSTOMER
}

model LeaseAgreement {
  id                        String           @id @default(uuid())
  loanId                    String           @unique
  status                    LeaseStatus      @default(ACTIVE)
  /// Snapshot of the residual amount due at end-of-term.
  residualValue             Decimal          @db.Decimal(14, 2)
  /// Title holder — flips to CUSTOMER after BUYOUT_COMPLETED.
  titleHolder               LeaseTitleHolder @default(COMPANY)
  /// True if the borrower is a company employee (employees can never be
  /// pulled out; the pull-out flow is non-employee only).
  isEmployee                Boolean
  /// Consecutive missed payments counter (reset on payment).
  missedPaymentStreak       Int              @default(0)
  /// When the customer was last warned about an impending pull-out.
  lastPullOutWarningAt      DateTime?
  /// 60-day-before-end-of-term notice fired.
  endOfTermNoticeSentAt     DateTime?
  /// Last maintenance reminder fired (6-month cadence).
  lastMaintenanceReminderAt DateTime?
  /// Set when status -> BUYOUT_COMPLETED. FK to the buyout JE.
  buyoutPaidAmount          Decimal?         @db.Decimal(14, 2)
  buyoutAt                  DateTime?
  buyoutById                String?
  buyoutJournalEntryId      String?
  /// Set when status -> PULLED_OUT.
  pulledOutAt               DateTime?
  pulledOutById             String?
  pullOutReason             String?          @db.VarChar(500)
  /// Set when status -> RETURNED or EXTENDED.
  closedAt                  DateTime?
  closedReason              String?          @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan         LoanApplication @relation(fields: [loanId], references: [id], onDelete: Cascade)
  buyoutBy     User?           @relation("LeaseBuyoutBy", fields: [buyoutById], references: [id])
  pulledOutBy  User?           @relation("LeasePulledOutBy", fields: [pulledOutById], references: [id])
  journalEntry JournalEntry?   @relation(fields: [buyoutJournalEntryId], references: [id])

  @@index([status])
}

// ─── Multi-tenancy (Phase 2 foundation) ────────────────────────────────────
//
// The `Tenant` table lives in the SHARED `public` schema and acts as the
// control-plane catalog: one row per cooperative customer on this
// installation. Domain data (Customer, Loan, etc.) lives in a dedicated
// Postgres schema named `tenant_<slug>` — a request's tenant is
// resolved at auth time and Prisma is bound to that schema for the
// duration of the request via `search_path`.
//
// This commit ships ONLY the catalog. Wiring (per-request schema
// switching, repo-layer enforcement, migration runner) lands in a
// later commit. See docs/multi-tenant-roadmap.md for the full plan.

model Tenant {
  id                String       @id @default(uuid())
  /// URL-safe slug — used as the Postgres schema name (`tenant_<slug>`).
  /// Lowercase alphanumeric + dashes. Enforced by zod at the API layer
  /// since Prisma doesn't support CHECK constraints natively.
  slug              String       @unique
  /// Human-readable name (cooperative legal name).
  name              String
  status            TenantStatus @default(PROVISIONING)
  /// JSON snapshot of the license that was active when this tenant was
  /// last seen. Lets the platform console show "Mt Banahaw MPC →
  /// ENTERPRISE, expires 2027-05-22" without reaching into the tenant
  /// schema. Refreshed by the tenant's API on every license activation.
  licenseSnapshot   Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  /// When the tenant was last seen calling back to the platform (license
  /// check-in, telemetry ping). Null until the first contact.
  lastSeenAt        DateTime?
  /// Captures the most recent provisioning failure. Set when
  /// background provisioning throws; cleared when provisioning
  /// succeeds (status flips to ACTIVE). Surfaced on the platform
  /// console's tenant detail page so vendor staff can see what
  /// went wrong without trawling logs.
  provisioningError String?      @db.Text

  @@index([status])
  @@index([lastSeenAt])
}

enum TenantStatus {
  PROVISIONING // schema being created / migrations running
  ACTIVE // healthy, serving traffic
  SUSPENDED // license lapsed or platform-imposed pause
  ARCHIVED // soft-deleted; data retained but no longer served
}

// Platform-side users — the vendor's team, NOT a tenant's staff. Lives
// in `public` schema. Authenticates against /platform/auth/login and
// receives a JWT with `platform: true` claim. Strictly separate from
// the per-tenant User table.
model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  role         PlatformRole @default(PLATFORM_SALES)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?
}

enum PlatformRole {
  PLATFORM_ADMIN // everything: provision, suspend, archive, issue licenses
  PLATFORM_SALES // view + issue licenses, no destructive ops
}

// Platform-side record of every license issued. Mirror of the
// tenant-side License model — that one tracks *activations* on the
// tenant instance, this one tracks *issuances* on the vendor's
// control plane. The two never share rows; the JTI is the only link.
//
// We keep the full token here because (a) re-sending it to the
// tenant admin is the most common follow-up after issuance, and (b)
// the platform private key isn't always available in this process,
// so we can't re-mint it.
//
// Revocation is platform-side-only for now — the signed token still
// verifies on the tenant instance until its `exp` field. A future
// CRL endpoint (GET /platform/crl, signed list of revoked JTIs)
// would close the gap, but isn't needed for v1 since revocation in
// practice means "don't renew + manually suspend the tenant".
model PlatformIssuedLicense {
  id            String    @id @default(uuid())
  /// JWT id from the signed payload. Unique per issued license.
  jti           String    @unique
  /// Slug of the tenant the license was issued for. Denormalized so
  /// "list licenses for tenant X" is a plain index scan, no joins.
  tenantSlug    String
  /// Display name embedded in the token at issuance time.
  tenantName    String
  /// Tier string ("BASIC" | "PROFESSIONAL" | "ENTERPRISE") — kept as
  /// text so the platform schema doesn't depend on the licensing lib's
  /// enum.
  tier          String
  /// Full wire-format token. Stored so the operator can re-send it
  /// to the tenant admin without re-issuing (which would mint a new
  /// JTI).
  token         String
  /// Verified payload at issuance. JSONB for cheap "tier=ENTERPRISE
  /// AND active" queries without re-parsing.
  payload       Json
  issuedAt      DateTime  @default(now())
  notBefore     DateTime?
  expiresAt     DateTime
  seats         Int       @default(0)
  notes         String?
  /// PlatformUser id of whoever issued it. No FK — same denormalized
  /// pattern as PlatformAuditLog.
  issuedById    String
  issuedByEmail String
  /// When the issuance was revoked on the platform side. Null = the
  /// license is still considered active (subject to its `expiresAt`).
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  @@index([tenantSlug, issuedAt(sort: Desc)])
  @@index([revokedAt])
  @@index([expiresAt])
}

// Append-only platform-action audit. Separate from per-tenant AuditLog
// so cross-tenant queries are cheap and so tenant admins can't see the
// vendor's internal actions.
model PlatformAuditLog {
  id         String   @id @default(uuid())
  action     String // PLATFORM_TENANT_PROVISION, PLATFORM_LICENSE_ISSUE, ...
  actorId    String
  actorEmail String
  /// The tenant the action targeted, when applicable. Null for system-level
  /// actions (cross-tenant report exports, etc.).
  tenantSlug String?
  payload    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([tenantSlug])
}

// ─── Marketing / lead capture ──────────────────────────────────────────────
//
// Anonymous lead captures from the marketing site (apps/marketing).
// Lives in `public` schema — leads exist before a Tenant does, and
// they're sales territory not tenant data. The platform console will
// surface this table in a future commit so vendor staff can triage
// leads + convert them into provisioned tenants.

model Lead {
  id                 String                 @id @default(uuid())
  name               String
  email              String
  cooperative        String
  /// Optional — helps sales recommend a tier without asking.
  memberCount        Int?
  deploymentInterest LeadDeploymentInterest @default(ONPREM)
  message            String?                @db.Text
  /// Where the form was submitted from. Lets sales tell if a lead came
  /// from the contact page, the pricing page, the install page, etc.
  source             String?
  /// Sales workflow state. Defaults to NEW; vendor staff move it
  /// through the funnel manually.
  status             LeadStatus             @default(NEW)
  /// PlatformUser id of whoever is handling the lead. Null = unassigned.
  assignedToId       String?
  notes              String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum LeadDeploymentInterest {
  ONPREM // wants to self-host
  HOSTED // wants the SaaS option
  BOTH // undecided / wants both pitches
}

enum LeadStatus {
  NEW // just submitted
  CONTACTED // sales has reached out
  QUALIFIED // real opportunity
  CONVERTED // became a Tenant
  REJECTED // not a fit (spam, wrong product, etc.)
}

/// A self-serve cooperative signup that hasn't proved its email yet.
///
/// Self-serve signup provisions a Postgres schema, runs every migration
/// against it, seeds it, and mints an admin whose password is shown
/// exactly once. Doing that straight off an anonymous POST means a
/// typo'd address produces a live tenant nobody can reach and nobody
/// cleans up. So the signup lands here first and provisioning waits on
/// a confirmed token.
///
/// Rows are disposable by design: unconfirmed ones expire, and the slug
/// is NOT reserved while pending (see the note on `slug`).
model PendingTenantSignup {
  id String @id @default(uuid())

  /// Desired schema name. Deliberately NOT unique and NOT a
  /// reservation — two people may request the same slug, and whoever
  /// confirms first gets it. Reserving on request would let anyone
  /// squat every good name with unverifiable addresses, which is a
  /// worse failure than the loser of a race seeing "already taken".
  slug       String
  name       String
  adminEmail String
  adminName  String

  /// SHA-256 of the token in the confirmation link — same treatment as
  /// RefreshToken. The plaintext exists only in the email; a database
  /// leak must not hand anyone the ability to provision.
  tokenHash String @unique

  expiresAt  DateTime
  /// Set when the token is redeemed. Kept rather than deleted so a
  /// second click on the same link can say "already used" instead of
  /// "invalid", and so support can see the signup happened.
  consumedAt DateTime?
  /// Slug actually provisioned on confirmation. Usually equals `slug`;
  /// present so support can trace a pending row to its tenant.
  tenantSlug String?

  createdAt DateTime @default(now())

  @@index([adminEmail])
  /// Supports the sweep that deletes expired unconfirmed rows.
  @@index([expiresAt])
}

// ─── Licensing ──────────────────────────────────────────────────────────────
//
// Persisted record of every license activation on this instance. The
// "current" license is the most recent row with revokedAt = null and a
// valid signature (re-verified on every boot). History stays in the DB
// so admins can see when each upgrade / renewal happened without
// digging through audit logs.
//
// The `token` column is the full wire-format token the platform issued.
// We keep it in the clear because (a) the signature is the security
// boundary, (b) we re-verify on boot, and (c) operators can paste it
// elsewhere if they need to re-install. The `payload` JSON column is a
// denormalized snapshot of what the token unlocked at activation time
// — useful for queries ("how many active ENTERPRISE tenants?") without
// re-parsing every row.

model License {
  id            String    @id @default(uuid())
  /// Full wire-format token (SMARTLOAN-LIC-v1.<payload>.<signature>).
  token         String
  /// JWT id from the payload — unique per issued license. Lets us
  /// detect re-activation of the same token and avoid duplicate rows.
  jti           String    @unique
  tenantName    String
  tier          String
  /// Snapshot of the verified payload at activation. JSON for grep-
  /// ability without parsing the token on every read.
  payload       Json
  issuedAt      DateTime
  notBefore     DateTime?
  expiresAt     DateTime
  seats         Int       @default(0)
  notes         String?
  /// When the operator clicked Activate. Distinct from `issuedAt`,
  /// which is when the platform minted the token.
  activatedAt   DateTime  @default(now())
  activatedById String?
  /// When an operator explicitly deactivated this license. Inactive
  /// when non-null; the boot hook ignores revoked rows.
  revokedAt     DateTime?
  revokedById   String?

  activatedBy User? @relation("LicenseActivatedBy", fields: [activatedById], references: [id])
  revokedBy   User? @relation("LicenseRevokedBy", fields: [revokedById], references: [id])

  @@index([revokedAt, expiresAt])
}
