{
  "name": "@loan/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "dev:license": "dotenv -e ../../.env -- tsx ../../scripts/dev-license.mjs",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "migrate-tenants": "dotenv -e ../../.env -- tsx scripts/migrate-tenants.mjs",
    "repair-payments": "dotenv -e ../../.env -- tsx scripts/repair-payments.mjs",
    "sweep-orphans": "dotenv -e ../../.env -- tsx scripts/sweep-orphaned-entries.mjs",
    "adopt-existing-as-tenant": "dotenv -e ../../.env -- tsx scripts/adopt-existing-as-tenant.mjs",
    "bootstrap-admin": "dotenv -e ../../.env -- tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@loan/accounting": "workspace:*",
    "@loan/credit-scoring": "workspace:*",
    "@loan/decisioning": "workspace:*",
    "@loan/jobs": "workspace:*",
    "@loan/loans": "workspace:*",
    "@loan/notifications": "workspace:*",
    "@loan/payments": "workspace:*",
    "@loan/screening": "workspace:*",
    "@loan/shared-types": "workspace:*",
    "@prisma/client": "^6.19.3",
    "fastify-plugin": "^5.1.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@loan/auth": "workspace:*",
    "@types/node": "^22.20.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.11.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "~5.7.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  }
}
