{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@loan/db":             ["libs/db/src/index.ts"],
      "@loan/auth":           ["libs/auth/src/index.ts"],
      "@loan/credit-scoring": ["libs/credit-scoring/src/index.ts"],
      "@loan/loans":          ["libs/loans/src/index.ts"],
      "@loan/accounting":     ["libs/accounting/src/index.ts"],
      "@loan/payments":       ["libs/payments/src/index.ts"],
      "@loan/jobs":           ["libs/jobs/src/index.ts"],
      "@loan/notifications":  ["libs/notifications/src/index.ts"],
      "@loan/screening":      ["libs/screening/src/index.ts"],
      "@loan/decisioning":    ["libs/decisioning/src/index.ts"],
      "@loan/pdf":            ["libs/pdf/src/index.ts"],
      "@loan/kyc":            ["libs/kyc/src/index.ts"],
      "@loan/api-client":     ["libs/api-client/src/index.ts"],
      "@loan/ui":             ["libs/ui/src/index.ts"],
      "@loan/features":       ["libs/features/src/index.ts"],
      "@loan/shared-types":   ["libs/shared-types/src/index.ts"],
      "@loan/shared-utils":   ["libs/shared-utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist"]
}
